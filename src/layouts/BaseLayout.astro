---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { absoluteUrl, isEnglishPath, normalisePath, translatedPath, SITE } from "../data/routes";
import { organization, website } from "../data/seo";
// Fonts are self-hosted (see global.css); preload the Latin subsets so text renders without waiting.
import soraFont from "@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url";
import interFont from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
  lang?: "nl" | "en";
  /** Use the title as-is instead of appending " | Gedekt". */
  fullTitle?: boolean;
  /** Share image, path under public/. */
  image?: string;
  ogType?: "website" | "article";
  /** Extra schema.org nodes for this page; Organization and WebSite are always included. */
  jsonLd?: object[];
  noindex?: boolean;
}

const {
  title,
  description = "Gedekt — Workforce scheduling for Dutch hospitality. Built for venues with 5–20 staff. Flat pricing, smart fill engine, Dutch-first.",
  lang = "en",
  fullTitle = false,
  image = "/og-image.png",
  ogType = "website",
  jsonLd = [],
  noindex = false,
} = Astro.props;

const pageTitle = fullTitle ? title : `${title} | Gedekt`;
const path = normalisePath(Astro.url.pathname);
const canonical = absoluteUrl(path);

// hreflang: this page plus its translation; x-default points to the Dutch version.
const other = translatedPath(path);
const nlPath = isEnglishPath(path) ? other : path;
const enPath = isEnglishPath(path) ? path : other;
const alternates = [
  nlPath && { hreflang: "nl", href: absoluteUrl(nlPath) },
  enPath && { hreflang: "en", href: absoluteUrl(enPath) },
  nlPath && { hreflang: "x-default", href: absoluteUrl(nlPath) },
].filter(Boolean) as { hreflang: string; href: string }[];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [organization, website, ...jsonLd],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Gedekt" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={SITE + image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === "nl" ? "nl_NL" : "en_GB"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={SITE + image} />
    <meta name="theme-color" content="#1B4332" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={soraFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />
  </head>
  <body class="antialiased">
    <Nav currentPath={Astro.url.pathname} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
