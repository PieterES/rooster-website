---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Button from "../components/Button.astro";
import DemoVideo from "../components/DemoVideo.astro";
import { demos, demoBySlug, demoHref } from "../data/demos";

const steps = [
  {
    number: "01",
    title: "Richt je bedrijf in",
    body: "Maak een account aan, voeg je afdelingen toe (Bar, Keuken, Bediening) en geef ze functies. Geen technische configuratie, geen IT-afdeling.",
    qa: [{ q: "Moet ik een database instellen?", a: "Nee. Alles wordt gehost. Je hoeft alleen maar aan te melden." }],
    demo: "afdelingen-en-functies",
  },
  {
    number: "02",
    title: "Voeg je team toe",
    body: "Voeg medewerkers toe met hun afdeling, functie, contracturen en uurloon. Ze krijgen direct een uitnodiging voor de app.",
    qa: [],
    demo: "medewerker-toevoegen",
  },
  {
    number: "03",
    title: "Medewerkers geven hun beschikbaarheid op",
    body: "Elk teamlid vinkt in de app aan welke diensten ze kunnen werken — of liever werken. Het systeem leest dit direct, zonder handmatige vertaalslag.",
    qa: [],
    demo: "medewerkers-app",
    clip: "staff-availability",
  },
  {
    number: "04",
    title: "Genereer, controleer en publiceer",
    body: "Eén klik vult het rooster in. Controleer het, pas aan wat je wil via drag-and-drop, en publiceer. Je team ontvangt direct een melding.",
    qa: [],
    demo: "rooster-maken",
  },
];

const quickFAQ = [
  { q: "Hoe lang duurt de initiële setup?", a: "De meeste locaties zijn volledig live binnen 30 minuten. Medewerkers, afdelingen, rangen en de eerste wekelijkse template toevoegen is eenvoudig." },
  { q: "Kan ik het gebruiken zonder de automatische generatiefunctie?", a: "Ja. Starter bevat een volledige rooster bouwer. Automatisch genereren is een Pro-functie." },
  { q: "Wat als mijn team niet zo technisch is?", a: "De medewerkers-app is bewust minimalistisch — medewerkers zien hun diensten, geven beschikbaarheid op en vragen wisselingen aan. Drie schermen, meer niet." },
];

const features = [
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14"/><path d="M15.54 8.46a5 5 0 010 7.07M8.46 8.46a5 5 0 000 7.07"/></svg>`,
    title: "Slimme Inplanmotor",
    demo: "rooster-maken",
    hook: "Het enige planningssysteem dat weet wie wat kan doen — niet alleen wie er vrij is.",
    bullets: [
      "Vult elke dienst in met de meest geschikte medewerker op basis van afdeling, rang, voorkeur en beschikbaarheid",
      "Stel zelf invul regels vast: een barmanager kan barmedewerker diensten opvullen; niet andersom",
      "Voorkomt ongeldige planning: geen zondagavondsluiters ook op maandagochtend",
    ],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01"/></svg>`,
    title: "Beschikbaarheidsbeheer",
    demo: "medewerkers-app",
    hook: "Templates die medewerkers daadwerkelijk bijhouden — omdat het systeem er ook echt mee rekening houdt.",
    bullets: [
      "Wekelijkse beschikbaarheidstemplates die automatisch doorlopen totdat ze worden gewijzigd",
      "Losse uitzonderingen voor specifieke datums zonder de template te verstoren",
      "Manager ziet onopgeloste beschikbaarheidsgaten vóór het genereren, niet erna",
    ],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 9l4 4 10-10"/><rect x="3" y="3" width="18" height="18" rx="2"/></svg>`,
    title: "Online Roosterbewerking",
    demo: "vaste-diensten",
    hook: "Het systeem stelt voor; jij beslist. Volledig handmatig aanpassen zonder gedoe.",
    bullets: [
      "Het systeem controleert en waarschuwt bij conflicten maar blokkeert niet",
      "Vergrendelde toewijzingen blijven staan bij opnieuw genereren",
      "Live conflictindicatoren: rusttijdschendingen, dubbele boekingen en afdelingsmismatches direct zichtbaar",
      "In één oogopslag zie je wie geschikt is voor welke plek — op basis van rol, afdeling en contracturen",
      "Dagenvoorkeur en dienststype per medewerker direct zichtbaar bij het inplannen, zodat je altijd weet wie liever ochtend- of avonddiensten draait",
      "Realtime beschikbaarheidstelling per dienst: zie hoeveel medewerkers er beschikbaar zijn voordat je een dienst toewijst",
    ],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>`,
    title: "Dienstwissel & Open Diensten",
    demo: "claims-en-ruilverzoeken",
    hook: "Medewerkers regelen wisselingen onderling. Jij keurt alleen goed.",
    bullets: [
      "Medewerker vraagt wisseling aan bij een collega; beiden bevestigen; manager keurt goed of af",
      "Open diensten: publiceer een onbezette plek; in aanmerking komende medewerkers kunnen hem claimen",
      "Duidelijke communicatie — geen onduidelijkheid meer over 'ik dacht dat jij dat met Joost had afgesproken'",
    ],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>`,
    title: "Verlof- en Verzuimbeheer",
    hook: "Eén plek voor verlofaanvragen, ziekmeldingen en vrije dagen — direct gekoppeld aan het rooster.",
    bullets: [
      "Medewerkers dienen verlofaanvragen in via de app; manager keurt met één tik goed",
      "Goedgekeurd verlof blokkeert de medewerker automatisch bij het inplannen",
      "Urenregistratie integreert met verlof voor nauwkeurige weektotalen",
    ],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    title: "In- en Uitklokken & Urenregistratie",
    demo: "uren-en-loonkosten",
    hook: "Weet precies wie werkte, wanneer en hoeveel uur — zonder spreadsheets.",
    bullets: [
      "Medewerkers klokken via de app; tijdstempels worden direct opgeslagen",
      "Correctieverzoeken voor gemiste diensten — manager keurt inline goed",
      "Wekelijks urenoverzicht per medewerker, met automatische signalering van te veel of te weinig uren",
    ],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>`,
    title: "Medewerker Self-Service",
    demo: "medewerkers-app",
    hook: "Je medewerkers hebben geen training nodig. Ze checken diensten zoals ze alles checken — op hun telefoon.",
    bullets: [
      "Installeerbare app werkt op elk apparaat",
      "Pushmeldingen voor nieuwe roosters, wisselgoedkeuringen en dienstwijzigingen",
      "Medewerkers zien hun week in één oogopslag, vragen wijzigingen aan, geven beschikbaarheid op — zonder inloggedoe",
    ],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>`,
    title: "Automatische Herinneringen & Geplande Publicatie",
    hook: "Stel het eenmalig in. Het systeem herinnert je team en publiceert het rooster op jouw moment.",
    bullets: [
      "Stel een vast tijdstip in waarop medewerkers automatisch een herinnering krijgen om hun beschikbaarheid in te vullen — wekelijks, op de dag en tijd die jij kiest",
      "Configureer een automatisch genereer- en publicatiemoment: het systeem maakt het rooster en stuurt iedereen een melding zonder dat jij er iets voor hoeft te doen",
      "Medewerkers ontvangen een pushmelding en e-mail zodra het rooster live is — geen aparte berichtjes sturen",
    ],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 12l2 2 4-4"/></svg>`,
    title: "Taaklists & Checklists",
    hook: "Altijd duidelijk wat er gedaan moet worden — en wie het heeft gedaan.",
    bullets: [
      "Maak terugkerende checklists per dienst: openingschecks, sluitingsprocedures en schoonmaakschema's",
      "Medewerkers vinken taken af via de app; de manager ziet realtime welke taken zijn voltooid",
      "Taakhistorie per dienst zodat je nooit hoeft te raden of de koelkast is gecheckt",
    ],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>`,
    title: "Meerdere Afdelingen & Rolconfiguratie",
    demo: "afdelingen-en-functies",
    hook: "Twee afdelingen of twaalf — de structuur past zich aan jouw locatie aan, niet andersom.",
    bullets: [
      "Maak afdelingen aan (Bar, Keuken, Bediening, Bewaking) met eigen diensttypen per afdeling, compleet met eigen regels en beperkingen",
      "Definieer rangen binnen afdelingen met invulregels: wie kan wiens rol in noodgevallen overnemen",
      "Per-afdeling roosteren zodat bar- en keukenmanagers hun eigen overzicht hebben",
    ],
  },
];

---

<BaseLayout
  title="Hoe het werkt"
  description="Van setup naar eerste gepubliceerde rooster in minder dan 30 minuten. Bekijk in korte video's hoe Gedekt werkt — en alles wat erin zit."
  lang="nl"
>

  <!-- Hero -->
  <section class="bg-[var(--color-forest)] pt-32 pb-20 px-6 lg:px-8 text-white">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="font-display font-bold text-4xl md:text-5xl leading-tight mb-4">
        Van setup naar eerste rooster<br/>in minder dan 30 minuten.
      </h1>
      <p class="text-white/80 text-lg leading-relaxed">
        Geen integraties vereist. Geen IT-afdeling nodig. Alleen een locatie, een team en 30 minuten.
      </p>
    </div>
  </section>

  <!-- Steps, each with its demo clip -->
  <section class="bg-white py-20 px-6 lg:px-8">
    <div class="max-w-6xl mx-auto space-y-24">
      {steps.map((step, i) => {
        const demo = demoBySlug(step.demo, "nl")!;
        return (
          <div class:list={["flex flex-col md:flex-row gap-12 items-center", i % 2 === 1 && "md:flex-row-reverse"]}>
            <div class="flex-1">
              <div class="font-display font-bold text-7xl text-[var(--color-amber)] opacity-20 leading-none select-none mb-2">{step.number}</div>
              <h2 class="font-display font-bold text-2xl md:text-3xl text-[var(--color-charcoal)] mb-3 -mt-4">{step.title}</h2>
              <p class="text-[var(--color-stone)] leading-relaxed text-lg mb-4">{step.body}</p>
              {step.qa.map((qa) => (
                <div class="bg-[var(--color-cream)] rounded-xl p-4 mt-3 mb-4">
                  <p class="text-sm font-semibold text-[var(--color-charcoal)] mb-1">{qa.q}</p>
                  <p class="text-sm text-[var(--color-stone)]">{qa.a}</p>
                </div>
              ))}
              <a href={demoHref(demo, "nl")} class="inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-forest)] hover:text-[var(--color-amber)] transition-colors">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="6 4 20 12 6 20 6 4"/></svg>
                Bekijk de demo
              </a>
            </div>
            <div class="flex-1 w-full">
              {demo.device === "phone" ? (
                <DemoVideo name={step.clip ?? demo.clips[0].name} lang="nl" label={step.title} device="phone" />
              ) : (
                <DemoVideo name={demo.clips[0].name} lang="nl" label={step.title} url={demo.url?.nl} />
              )}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- Demo's -->
  <section class="bg-[var(--color-cream)] py-16 px-6 lg:px-8">
    <div class="max-w-5xl mx-auto text-center">
      <p class="text-[var(--color-amber)] font-semibold text-sm uppercase tracking-widest mb-2">Meer demo's</p>
      <p class="text-[var(--color-stone)] text-sm mb-6">Korte video's van de echte app — geen mockups.</p>
      <div class="flex flex-wrap justify-center gap-3">
        {demos.map((d) => (
          <a href={demoHref(d, "nl")} class="inline-flex items-center gap-2 bg-white border border-gray-200 rounded-full px-4 py-2 text-sm font-medium text-[var(--color-charcoal)] hover:border-[var(--color-forest)] hover:text-[var(--color-forest)] transition-colors">
            <svg class="w-3 h-3 text-[var(--color-forest)]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="6 4 20 12 6 20 6 4"/></svg>
            {d.menuLabel.nl}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Functieraster -->
  <section id="functies" class="bg-white py-20 px-6 lg:px-8 scroll-mt-16">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-2xl mx-auto text-center mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl text-[var(--color-charcoal)] leading-tight mb-4">Alles wat erin zit</h2>
        <p class="text-lg text-[var(--color-stone)] leading-relaxed">Elke functie is ontworpen rond hoe een echte horecalocatie daadwerkelijk werkt.</p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {features.map((f) => (
          <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 p-6 rounded-2xl border border-gray-100 hover:border-[var(--color-forest)]/20 hover:shadow-md transition-all duration-300">
            <div class="w-12 h-12 bg-[#E8F5EE] rounded-xl flex items-center justify-center text-[var(--color-forest)] shrink-0" set:html={f.icon} />
            <div class="text-center sm:text-left">
              <h3 class="font-display font-semibold text-lg text-[var(--color-charcoal)] mb-1">{f.title}</h3>
              <p class="text-[var(--color-amber)] text-sm font-medium mb-3">{f.hook}</p>
              <ul class="space-y-1.5">
                {f.bullets.map((b) => (
                  <li class="flex items-start gap-2 text-sm text-[var(--color-stone)]">
                    <svg class="w-4 h-4 text-[var(--color-forest)] mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    {b}
                  </li>
                ))}
              </ul>
              {f.demo && (
                <a href={demoHref(demoBySlug(f.demo, "nl")!, "nl")} class="inline-flex items-center gap-1.5 mt-4 text-sm font-semibold text-[var(--color-forest)] hover:text-[var(--color-amber)] transition-colors">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="6 4 20 12 6 20 6 4"/></svg>
                  Bekijk hoe het werkt
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-[var(--color-cream)] py-20 px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-8 text-center">Snelle antwoorden</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {quickFAQ.map((item) => (
          <div class="bg-white rounded-2xl p-6 border border-gray-100">
            <p class="font-semibold text-[var(--color-charcoal)] mb-2 text-sm">{item.q}</p>
            <p class="text-[var(--color-stone)] text-sm leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Altijd in ontwikkeling -->
  <section class="bg-[var(--color-forest)] py-16 px-6 lg:px-8 text-white">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="font-display font-bold text-2xl md:text-3xl mb-4">We zijn constant bezig.</h2>
      <p class="text-white/80 text-lg leading-relaxed mb-8">
        Gedekt wordt continu verbeterd, bijgewerkt en uitgebreid met nieuwe functionaliteit. We zijn een klein team dat snel kan schakelen — en dat merken onze gebruikers.
      </p>
      <div class="bg-white/10 border border-white/20 rounded-2xl p-6 text-left max-w-2xl mx-auto mb-6">
        <p class="text-white/60 text-xs font-semibold uppercase tracking-wider mb-3">Binnenkort</p>
        <ul class="space-y-4">
          <li class="flex items-start gap-3 text-white/85">
            <span class="text-[var(--color-amber)] font-bold mt-0.5 shrink-0">→</span>
            <span><strong class="text-white">Meer integraties</strong> — Directe koppelingen met salarisverwerking en kassasystemen.</span>
          </li>
        </ul>
      </div>
      <p class="text-white/60 text-sm">Heb je een idee of wens? We luisteren. <a href="/contact" class="text-[var(--color-amber)] underline hover:text-white transition-colors">Stuur ons een berichtje →</a></p>
    </div>
  </section>


  <!-- CTA -->
  <section class="bg-[var(--color-dark)] py-20 px-6 lg:px-8">
    <div class="max-w-2xl mx-auto text-center text-white">
      <h2 class="font-display font-bold text-3xl md:text-4xl mb-4">Klaar om het te proberen?</h2>
      <p class="text-white/70 mb-8">Vanaf €10/maand. Geen jaarcontract vereist.</p>
      <Button href="https://app.gedekt.com" variant="secondary" size="lg">Aan de slag →</Button>
    </div>
  </section>

</BaseLayout>
