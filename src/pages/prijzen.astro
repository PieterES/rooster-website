---
import BaseLayout from "../layouts/BaseLayout.astro";
import PricingCard from "../components/PricingCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Button from "../components/Button.astro";
import { faqPage, softwareApplication } from "../data/seo";

const starterFeatures = [
  { text: "Handmatige roosterbouwer", included: true },
  { text: "Beschikbaarheidsbeheer", included: true },
  { text: "Dienstwisselingen & verlofaanvragen", included: true },
  { text: "Open diensten", included: true },
  { text: "PWA mobiele app", included: true },
  { text: "E-mailmeldingen", included: true },
  { text: "In- en uitklokken & urenregistratie", included: true },
  { text: "Automatisch rooster genereren (1\u00d7 probeerbeurt)", included: true },
  { text: "E-mailondersteuning", included: false },
];

const proFeatures = [
  { text: "Alles in Starter", included: true },
  { text: "Automatisch rooster genereren", included: true },
  { text: "Meerdere locaties", included: true },
  { text: "Wissel-auditlog", included: true },
  { text: "Verlofgoedkeuringsworkflow", included: true },
  { text: "E-mailondersteuning (1 werkdag)", included: true },
];

const businessFeatures = [
  { text: "Alles in Pro", included: true },
  { text: "Meerdere roosters genereren, beste kiezen", included: true },
  { text: "Prioriteitsondersteuning", included: true },
  { text: "Persoonlijke onboarding", included: true },
];

const faq = [
  {
    q: "Hoe werkt de gratis maand?",
    a: "Elk plan begint met een maand gratis. Je hoeft geen betaalgegevens in te vullen. Na die maand kies je zelf of je doorgaat; er wordt niets automatisch afgeschreven. Ga je niet door, dan blijven je gegevens bewaard, maar kun je niets meer wijzigen totdat je een abonnement afsluit.",
  },
  {
    q: "Is er een jaarlijks abonnement?",
    a: "Ja. Bij jaarlijkse betaling krijg je 2 maanden gratis \u2014 je betaalt 10 maanden en gebruikt 12. Gebruik de toggle hierboven om de jaarprijs te zien. Je tarief staat voor het hele jaar vast.",
  },
  {
    q: "Kan ik halverwege de maand van abonnement wisselen?",
    a: "Ja. Wisselen gaat direct en wordt naar ratio berekend — je betaalt alleen voor de dagen dat je elk plan gebruikte.",
  },
  {
    q: "Wat gebeurt er als ik het limiet voor medewerkers overschrijd?",
    a: "Je krijgt een melding om te upgraden. Er is geen harde afsluiting, geen dataverlies en geen onderbrekingen in de dienst — we vragen je gewoon om op te schalen wanneer je gegroeid bent.",
  },
  {
    q: "Is er een korting voor seizoensbedrijven?",
    a: "Ja. Neem direct contact op en we regelen iets passends. We houden je liever op een eerlijk tarief dan je 4 maanden kwijt te zijn.",
  },
  {
    q: "Bieden jullie kortingen aan voor non-profits of buurtverenigingen?",
    a: "Ja. Neem contact op en we denken mee.",
  },
];
---

<BaseLayout
  title="Prijzen rooster app horeca – vanaf €10/maand"
  description="Probeer Gedekt een maand gratis. Daarna vaste prijzen vanaf €10/maand, zonder kosten per medewerker en zonder jaarcontract."
  lang="nl"
  jsonLd={[softwareApplication("nl"), faqPage(faq)]}
>

  <!-- Hero -->
  <section class="bg-[var(--color-cream)] pt-32 pb-12 px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="font-display font-bold text-4xl md:text-5xl text-[var(--color-charcoal)] leading-tight mb-4">
        Vaste prijs.<br/>Geen verrassingen per medewerker.
      </h1>
      <p class="text-lg text-[var(--color-stone)] leading-relaxed">
        Geen contracten. Op elk moment opzegbaar. Begint bij €10/maand.
      </p>
      <p class="inline-flex items-center gap-2 mt-6 bg-[var(--color-amber)]/15 border border-[var(--color-amber)]/30 text-[var(--color-charcoal)] text-lg font-semibold rounded-full px-6 py-3">
        <svg class="w-5 h-5 text-[var(--color-amber)] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M19 12v7a2 2 0 01-2 2H7a2 2 0 01-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 010-5C11 3 12 8 12 8s1-5 4.5-5a2.5 2.5 0 010 5"/></svg> Eerste maand gratis op elk plan — geen betaalgegevens nodig
      </p>
    </div>
  </section>

  <!-- Factuurperiode toggle -->
  <section class="bg-[var(--color-cream)] pt-8 pb-0 px-6 lg:px-8">
    <div class="max-w-5xl mx-auto flex justify-center">
      <div class="inline-flex items-center bg-white border border-gray-200 rounded-xl p-1 gap-1">
        <button
          id="billing-monthly"
          class="px-5 py-2 rounded-lg text-sm font-semibold transition-all duration-200 bg-[var(--color-forest)] text-white"
        >
          Maandelijks
        </button>
        <button
          id="billing-annual"
          class="px-5 py-2 rounded-lg text-sm font-semibold transition-all duration-200 text-[var(--color-stone)] hover:text-[var(--color-charcoal)]"
        >
          Jaarlijks
        </button>
      </div>
    </div>
  </section>

  <!-- Abonnementskaarten -->
  <section class="bg-[var(--color-cream)] py-12 px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">

        <PricingCard
          tier="Starter"
          priceMonthly="\u20ac10"
          priceAnnualMonthly="\u20ac8,33"
          priceAnnual="\u20ac100"
          staffLimit="Tot 15 medewerkers \u00b7 1 locatie"
          features={starterFeatures}
          cta="Start gratis \u2192"
          ctaHref="/aanmelden?plan=starter"
        />

        <PricingCard
          tier="Pro"
          priceMonthly="\u20ac20"
          priceAnnualMonthly="\u20ac16,67"
          priceAnnual="\u20ac200"
          staffLimit="Tot 25 medewerkers \u00b7 meerdere locaties"
          features={proFeatures}
          cta="Probeer Pro gratis \u2192"
          ctaHref="/aanmelden?plan=pro"
          highlighted={true}
          badge="Meest populair"
        />

        <PricingCard
          tier="Business"
          priceMonthly="\u20ac50"
          priceAnnualMonthly="\u20ac41,67"
          priceAnnual="\u20ac500"
          staffLimit="25+ medewerkers \u00b7 meerdere locaties"
          features={businessFeatures}
          cta="Probeer Business gratis \u2192"
          ctaHref="/aanmelden?plan=business"
        />
      </div>
    </div>
  </section>

  <!-- Callout -->
  <section class="bg-white py-14 px-6 lg:px-8">
    <div class="max-w-2xl mx-auto">
      <div class="bg-[#E8F5EE] border border-[var(--color-forest)]/20 rounded-2xl p-8 text-center">
        <div class="w-12 h-12 bg-[var(--color-forest)] rounded-xl flex items-center justify-center mx-auto mb-4">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <h3 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-3">Eerst een maand gratis</h3>
        <p class="text-[var(--color-charcoal)] leading-relaxed">
          <strong>Elk plan begint met een gratis maand</strong>, zonder betaalgegevens. Daarna kies je zelf of je doorgaat — er wordt niets automatisch afgeschreven. Geen kosten per medewerker, geen verrassingen op de factuur.
        </p>
      </div>
    </div>
  </section>

  <!-- Vergelijking met marktprijs -->
  <section class="bg-white py-12 px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
      <div class="bg-[var(--color-cream)] rounded-2xl p-8">
        <p class="text-xs font-semibold uppercase tracking-wider text-[var(--color-stone)] mb-4">De rekening</p>
        <p class="text-[var(--color-charcoal)] text-lg leading-relaxed mb-3">
          De meeste planningssoftware rekent <strong>€2,50–€4 per medewerker per maand.</strong>
        </p>
        <p class="text-[var(--color-charcoal)] text-lg leading-relaxed">
          Bij Gedekt betaalt een team van 25 personen in totaal <strong class="text-[var(--color-forest)]">€20/maand</strong> — dat is <strong class="text-[var(--color-forest)]">€0,80 per persoon.</strong>
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-[var(--color-cream)] py-20 px-6 lg:px-8">
    <div class="max-w-2xl mx-auto">
      <SectionHeading title="Veelgestelde vragen over prijzen" align="center" />
      <div class="bg-[var(--color-amber)]/10 border border-[var(--color-amber)]/30 rounded-xl px-6 py-4 mb-6">
        <p class="font-semibold text-[var(--color-charcoal)] text-sm mb-1">Past geen van de plannen precies?</p>
          <p class="text-[var(--color-stone)] text-sm leading-relaxed">
            Seizoensbedrijf, net boven een limiet of een andere situatie? Laat het ons weten — we zoeken samen naar een tarief dat werkt.<br /><a href="/contact" class="text-[var(--color-forest)] font-semibold hover:underline">Neem contact op →</a>
          </p>
      </div>
      <div class="space-y-3" id="faq-list">
        {faq.map((item, i) => (
          <div class="bg-white rounded-xl border border-gray-100 overflow-hidden">
            <button
              class="w-full text-left px-6 py-4 flex items-center justify-between font-medium text-[var(--color-charcoal)] hover:text-[var(--color-forest)] transition-colors"
              aria-expanded="false"
              data-faq-btn
            >
              {item.q}
              <svg class="w-5 h-5 shrink-0 transition-transform duration-200 text-[var(--color-stone)]" viewBox="0 0 20 20" fill="currentColor" data-chevron>
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
            <div class="px-6 pb-0 max-h-0 overflow-hidden transition-all duration-300" data-faq-body>
              <p class="text-[var(--color-stone)] pb-4 leading-relaxed">{item.a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Afsluiting CTA -->
  <section class="bg-[var(--color-forest)] py-20 px-6 lg:px-8">
    <div class="max-w-2xl mx-auto text-center text-white">
      <h2 class="font-display font-bold text-3xl mb-4">Klaar om te beginnen?</h2>
      <p class="text-white/80 mb-8">Eerste maand gratis, daarna vanaf €10/maand. Geen jaarcontract. Maak vandaag je eerste rooster.</p>
      <Button href="/aanmelden" variant="secondary" size="lg">Aan de slag →</Button>
    </div>
  </section>

</BaseLayout>

<script>
  // Billing toggle
  const monthlyBtn = document.getElementById("billing-monthly");
  const annualBtn = document.getElementById("billing-annual");
  const monthlyEls = document.querySelectorAll<HTMLElement>('[data-billing="monthly"]');
  const annualEls = document.querySelectorAll<HTMLElement>('[data-billing="annual"]');

  function setBilling(annual: boolean) {
    monthlyEls.forEach((el) => el.classList.toggle("hidden", annual));
    annualEls.forEach((el) => el.classList.toggle("hidden", !annual));
    if (annual) {
      monthlyBtn?.classList.remove("bg-[var(--color-forest)]", "text-white");
      monthlyBtn?.classList.add("text-[var(--color-stone)]");
      annualBtn?.classList.add("bg-[var(--color-forest)]", "text-white");
      annualBtn?.classList.remove("text-[var(--color-stone)]");
    } else {
      annualBtn?.classList.remove("bg-[var(--color-forest)]", "text-white");
      annualBtn?.classList.add("text-[var(--color-stone)]");
      monthlyBtn?.classList.add("bg-[var(--color-forest)]", "text-white");
      monthlyBtn?.classList.remove("text-[var(--color-stone)]");
    }
  }

  monthlyBtn?.addEventListener("click", () => setBilling(false));
  annualBtn?.addEventListener("click", () => setBilling(true));

  document.querySelectorAll<HTMLButtonElement>("[data-faq-btn]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const body = btn.nextElementSibling as HTMLElement;
      const chevron = btn.querySelector<SVGElement>("[data-chevron]");
      const isOpen = btn.getAttribute("aria-expanded") === "true";

      if (isOpen) {
        btn.setAttribute("aria-expanded", "false");
        body.style.maxHeight = "0";
        chevron?.classList.remove("rotate-180");
      } else {
        btn.setAttribute("aria-expanded", "true");
        body.style.maxHeight = body.scrollHeight + "px";
        chevron?.classList.add("rotate-180");
      }
    });
  });
</script>
