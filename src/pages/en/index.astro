---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import SectionHeading from "../../components/SectionHeading.astro";
---

<BaseLayout title="Your team, covered. Every shift, without the chaos.">

  <!-- SECTION 1: HERO -->
  <section data-hero class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=1600&auto=format&fit=crop&q=80"
        alt="Busy restaurant interior with warm lighting"
        class="w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-[#1B4332]/75"></div>
    </div>

    <div class="relative max-w-4xl mx-auto px-6 lg:px-8 text-center text-white py-32">
      <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-full px-4 py-1.5 mb-8 text-sm font-medium backdrop-blur-sm">
        <span class="w-2 h-2 rounded-full bg-[var(--color-amber)] animate-pulse"></span>
        Built for Dutch hospitality venues
      </div>

      <h1 class="font-display font-bold text-5xl md:text-6xl lg:text-7xl leading-tight mb-6">
        Your team, covered.<br/>
        <span class="text-[#FBBF24]">Every shift</span>, without the chaos.
      </h1>

      <p class="text-lg md:text-xl text-white/85 max-w-2xl mx-auto leading-relaxed mb-10">
        HorecaRooster builds your weekly schedule automatically — respecting who's available, who can cover which role, and who worked yesterday. Made for Dutch hospitality. Priced for real venues.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href="https://app.rooster-maker.app"
          class="bg-[var(--color-amber)] hover:bg-[var(--color-amber-light)] text-white font-semibold text-base px-8 py-4 rounded-xl transition-all duration-200 shadow-lg"
        >
          Get started — €10/month →
        </a>
        <a href="/en/how-it-works" class="text-white/90 underline underline-offset-4 font-medium hover:text-white transition-colors">
          See how it works →
        </a>
      </div>


    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-white/60 animate-bounce">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </div>
  </section>


  <!-- SECTION 2: PROBLEM -->
  <section class="bg-[var(--color-cream)] py-24 px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <SectionHeading title="Sound familiar?" subtitle="If you run a hospitality team, you've lived at least one of these." align="center" />
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {[
          { icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.68A2 2 0 012 .91h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>`, text: "Someone calls in sick Wednesday morning. You spend 40 minutes texting people who are already at another job." },
          { icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 014-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 01-4 4H3"/></svg>`, text: "You made the schedule Sunday \u2014 by Thursday it's wrong because Maria swapped with Joost but forgot to tell you." },
          { icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="18" y1="8" x2="23" y2="13"/><line x1="23" y1="8" x2="18" y2="13"/></svg>`, text: "Your best bartender quit. Partly because they kept getting scheduled for shifts they told you they couldn't do." },
          { icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>`, text: "You're paying for a scheduling app clearly designed for a 200-person hotel chain." },
        ].map((item) => (
          <div class="bg-white rounded-2xl p-7 border border-gray-100 shadow-sm flex gap-4 items-start">
            <div class="w-11 h-11 rounded-xl bg-[#E8F5EE] flex items-center justify-center text-[var(--color-forest)] shrink-0" set:html={item.icon} />
            <p class="text-[var(--color-charcoal)] leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- SECTION 3: SOLUTION — 3 STEPS -->
  <section class="bg-white py-24 px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <SectionHeading title="Set up once. Schedule in seconds." subtitle="Three steps from chaos to covered." align="center" />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
        {[
          { number: "01", title: "Set up your team once", body: "Add your staff, departments, roles, and when they're available. Takes 15 minutes." },
          { number: "02", title: "Let the engine build the schedule", body: "Auto-fills every shift with the right person for each role, respecting rest time and preferences. Not just who's free. Who's right." },
          { number: "03", title: "Review, adjust, publish", body: "Drag-and-drop to tweak anything. Hit publish. Your team gets notified instantly." },
        ].map((step) => (
          <div class="flex flex-col gap-3">
            <div class="font-display font-bold text-6xl text-[var(--color-amber)] opacity-30 leading-none select-none">{step.number}</div>
            <div class="-mt-4">
              <h3 class="font-display font-semibold text-xl text-[var(--color-charcoal)] mb-2">{step.title}</h3>
              <p class="text-[var(--color-stone)] leading-relaxed">{step.body}</p>
            </div>
          </div>
        ))}
      </div>
      <div class="text-center">
        <a href="/en/how-it-works" class="text-[var(--color-forest)] font-semibold hover:underline">See the full walkthrough →</a>
      </div>
    </div>
  </section>


  <!-- SECTION: APP PREVIEW -->
  <section class="bg-[var(--color-dark)] py-24 px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <p class="text-[var(--color-amber)] font-semibold text-sm uppercase tracking-widest mb-3">The app in action</p>
        <h2 class="font-display font-bold text-3xl md:text-4xl text-white mb-4">
          Built for managers and staff alike.
        </h2>
        <p class="text-white/70 text-lg max-w-2xl mx-auto">
          One platform — an intuitive app for your team, a powerful dashboard for you.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 lg:gap-20 items-end">
        <!-- Phone mockup -->
        <div class="flex flex-col items-center gap-6">
          <div class="relative w-52">
            <div class="bg-[#1C1C1E] rounded-[2.5rem] p-[7px] shadow-[0_30px_80px_rgba(0,0,0,0.6)] ring-1 ring-white/10">
              <div class="rounded-[2rem] overflow-hidden bg-gray-800">
                <img src="/screenshots/employee-dashboard.png" alt="Staff app dashboard" class="w-full block" loading="lazy" />
              </div>
            </div>
            <div class="absolute top-3 left-1/2 -translate-x-1/2 w-16 h-[14px] bg-[#1C1C1E] rounded-b-xl z-10"></div>
          </div>
          <div class="text-center">
            <p class="text-white font-display font-semibold text-lg mb-1">Staff App</p>
            <p class="text-white/60 text-sm">Schedule, availability, shifts & notifications</p>
          </div>
        </div>
        <!-- Browser mockup -->
        <div class="flex flex-col gap-5">
          <div class="rounded-xl overflow-hidden shadow-[0_30px_80px_rgba(0,0,0,0.5)] ring-1 ring-white/10">
            <div class="bg-[#1e2533] px-4 py-2.5 flex items-center gap-2 border-b border-white/10">
              <div class="flex gap-1.5">
                <div class="w-3 h-3 rounded-full bg-red-500/70"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-500/70"></div>
                <div class="w-3 h-3 rounded-full bg-green-500/70"></div>
              </div>
              <div class="flex-1 mx-3">
                <div class="bg-white/10 rounded px-3 py-1 text-xs text-white/40 font-mono">app.rooster-maker.app</div>
              </div>
            </div>
            <div class="bg-gray-800 overflow-hidden aspect-video">
              <img src="/screenshots/admin-schedule.png" alt="Manager schedule planner" class="w-full h-full object-cover object-top" loading="lazy" />
            </div>
          </div>
          <div class="text-center md:text-left">
            <p class="text-white font-display font-semibold text-lg mb-1">Manager Dashboard</p>
            <p class="text-white/60 text-sm">Planning, hours, requests & reports</p>
          </div>
        </div>
      </div>
      <div class="text-center mt-16">
        <a href="/en/product-tour" class="inline-flex items-center gap-2 text-[var(--color-amber)] font-semibold hover:text-[var(--color-amber-light)] transition-colors text-lg">
          See the full product tour →
        </a>
      </div>
    </div>
  </section>


  <!-- SECTION 4: FEATURE HIGHLIGHTS -->
  <section class="bg-[var(--color-cream)] py-24 px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <SectionHeading title="Built different. On purpose." subtitle="Not a generic scheduling tool with a hospitality skin." align="center" />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        {[
          {
            icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14"/><path d="M15.54 8.46a5 5 0 010 7.07M8.46 8.46a5 5 0 000 7.07"/></svg>`,
            title: "Automatic Fill Engine",
            hook: "Fills shifts the way you would — but faster.",
            body: "Knows which employee can cover which role. Respects experience, availability, and rest time. Explains every assignment so you stay in control.",
          },
          {
            icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
            title: "Availability That Means Something",
            hook: "Staff mark when they can work. The engine actually listens.",
            body: "Weekly templates plus one-off overrides. If someone can't do Fridays, the system won't put them on Fridays.",
          },
          {
            icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
            title: "Dutch-First by Design",
            hook: "Built for Dutch horeca.",
            body: "Built by people with experience in Dutch hospitality. Pricing that makes sense for a café, not a corporate canteen.",
          },
        ].map((card) => (
          <div class="bg-white rounded-2xl p-7 border border-gray-100 shadow-sm border-l-4 border-l-[var(--color-forest)] hover:shadow-md transition-shadow duration-300">
            <div class="w-11 h-11 rounded-xl bg-[#E8F5EE] flex items-center justify-center text-[var(--color-forest)] mb-4" set:html={card.icon} />
            <h3 class="font-display font-semibold text-lg text-[var(--color-charcoal)] mb-1">{card.title}</h3>
            <p class="text-[var(--color-amber)] text-sm font-medium mb-3">{card.hook}</p>
            <p class="text-[var(--color-stone)] text-sm leading-relaxed">{card.body}</p>
          </div>
        ))}
      </div>
      <div class="text-center">
        <Button href="/en/features" variant="primary" size="lg">Explore all features →</Button>
      </div>
    </div>
  </section>


  <!-- SECTION 5: WHY US -->
  <section class="bg-white py-24 px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <SectionHeading title="Simple. Personal. Fast." subtitle="We're a small team — and that's exactly the point." align="center" />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          {
            title: "Live in 15 minutes",
            body: "No lengthy onboarding, no consultant, no training days. Add your team, set availability, generate your first schedule — all on the same day. It really is that simple.",
          },
          {
            title: "Small team, personal attention",
            body: "You talk directly to the people building the product. No support ticket disappearing into a queue. Feedback that actually gets heard and acted on fast.",
          },
          {
            title: "Built by someone who's been there",
            body: "We spent years frustrated with apps built by people who've never worked a shift — overly complex, poorly designed, and expensive. HorecaRooster is the opposite.",
          },
        ].map((item) => (
          <div class="bg-[var(--color-cream)] rounded-2xl p-7 border border-gray-100">
            <h3 class="font-display font-semibold text-lg text-[var(--color-charcoal)] mb-2">{item.title}</h3>
            <p class="text-[var(--color-stone)] text-sm leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- SECTION 6: PRICING TEASER -->
  <section class="bg-[var(--color-forest)] py-24 px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center text-white">
      <h2 class="font-display font-bold text-3xl md:text-4xl mb-4 leading-tight">
        Pricing that respects how hospitality actually works.
      </h2>
      <p class="text-white/80 text-lg leading-relaxed mb-8">
        Free for teams of up to 5. Paid plans from <strong class="text-[#FBBF24]">€29/month</strong> — less than one hour of labor. No contracts, no per-employee pricing surprises, cancel any time.
      </p>
      <Button href="/en/pricing" variant="secondary" size="lg">See full pricing →</Button>
    </div>
  </section>


  <!-- SECTION 7: FINAL CTA -->
  <section class="bg-[var(--color-dark)] py-28 px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center text-white">
      <h2 class="font-display font-bold text-4xl md:text-5xl leading-tight mb-4">
        Ready to stop wrestling with the rota?
      </h2>
      <p class="text-white/70 text-lg mb-10">
        Start free today — set up your team in 15 minutes, generate your first schedule the same day.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="https://app.rooster-maker.app" variant="secondary" size="lg">Start for free →</Button>
        <Button href="/en/contact" variant="ghost" size="lg">Book a walkthrough →</Button>
      </div>
    </div>
  </section>

</BaseLayout>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.png" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body>
		<h1>Astro</h1>
	</body>
</html>
