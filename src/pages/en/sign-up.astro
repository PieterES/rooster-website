---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SignupForm from "../../components/SignupForm.astro";
---

<BaseLayout
  title="Free trial – staff scheduling app for hospitality"
  description="Create an account in a minute and try Gedekt free for a month. No payment details needed."
  lang="en"
>
  <section class="bg-[var(--color-cream)] pt-32 pb-12 px-6 lg:px-8">
    <div class="max-w-2xl mx-auto text-center">
      <h1 class="font-display font-bold text-4xl md:text-5xl text-[var(--color-charcoal)] leading-tight mb-3">
        Try Gedekt free for a month
      </h1>
      <p class="text-[var(--color-stone)] text-lg">Creating an account takes a minute. Your first schedule can be live today.</p>
    </div>
  </section>

  <section class="bg-white py-16 px-6 lg:px-8">
    <div class="max-w-2xl mx-auto">
      <SignupForm lang="en" />
    </div>
  </section>
</BaseLayout>
