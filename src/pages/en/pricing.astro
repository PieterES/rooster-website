---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PricingCard from "../../components/PricingCard.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import Button from "../../components/Button.astro";
import { faqPage, softwareApplication } from "../../data/seo";

const starterFeatures = [
  { text: "Manual schedule builder", included: true },
  { text: "Availability management", included: true },
  { text: "Shift swaps & leave requests", included: true },
  { text: "Open shifts", included: true },
  { text: "PWA mobile app", included: true },
  { text: "Email notifications", included: true },
  { text: "Clock in/out & hours tracking", included: true },
  { text: "Email support", included: false },
];

const proFeatures = [
  { text: "Everything in Starter", included: true },
  { text: "Auto-generate scheduling", included: true },
  { text: "Multiple locations", included: true },
  { text: "Leave approval workflow", included: true },
  { text: "Email support (1 business day)", included: true },
];

const businessFeatures = [
  { text: "Everything in Pro", included: true },
  { text: "Generate multiple schedules, pick the best", included: true },
  { text: "Priority support", included: true },
  { text: "Dedicated onboarding", included: true },
];

const faq = [
  {
    q: "How does the free month work?",
    a: "Every plan starts with one month free. You don't enter any payment details. After that month you decide whether to continue; nothing is charged automatically. If you don't continue, your data is kept, but you can't make changes until you subscribe.",
  },
  {
    q: "Is there an annual plan?",
    a: "Yes. With annual billing you get 2 months free \u2014 you pay for 10 months and use 12. Use the toggle above to see the annual price. Your rate is locked in for the full year.",
  },
  {
    q: "Can I switch tiers mid-month?",
    a: "Yes. Switching is instant and prorated — you'll only pay for the days you used each plan.",
  },
  {
    q: "What happens if I exceed my staff limit?",
    a: "You'll be prompted to upgrade. There's no hard cutoff, no data loss, and no service interruption — we just ask you to move up when you've grown beyond your tier.",
  },
  {
    q: "Is there a discount for seasonal businesses?",
    a: "Yes. Contact us directly and we'll work out a seasonal arrangement. We'd rather keep you on a fair deal than lose you for 4 months.",
  },
  {
    q: "Where is my data stored?",
    a: "All data is stored in the EU — Netherlands-based servers. We comply fully with GDPR.",
  },
  {
    q: "Do you offer discounts for non-profits or community clubs?",
    a: "Yes. Contact us and we'll work something out.",
  },
];
---

<BaseLayout
  title="Pricing – hospitality scheduling app from €10/month"
  description="Try Gedekt free for a month. Then flat pricing from €10/month, with no per-employee fees and no annual contract."
  jsonLd={[softwareApplication("en"), faqPage(faq)]}
>

  <!-- Hero -->
  <section class="bg-[var(--color-cream)] pt-32 pb-12 px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="font-display font-bold text-4xl md:text-5xl text-[var(--color-charcoal)] leading-tight mb-4">
        Flat pricing.<br/>No per-employee surprises.
      </h1>
      <p class="text-lg text-[var(--color-stone)] leading-relaxed">
        No contracts. Cancel any time. Starts at €10/month.
      </p>
      <p class="inline-flex items-center gap-2 mt-6 bg-[var(--color-amber)]/15 border border-[var(--color-amber)]/30 text-[var(--color-charcoal)] text-lg font-semibold rounded-full px-6 py-3">
        <svg class="w-5 h-5 text-[var(--color-amber)] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M19 12v7a2 2 0 01-2 2H7a2 2 0 01-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 010-5C11 3 12 8 12 8s1-5 4.5-5a2.5 2.5 0 010 5"/></svg> First month free on every plan — no payment details needed
      </p>
    </div>
  </section>

  <!-- Billing toggle -->
  <section class="bg-[var(--color-cream)] pt-8 pb-0 px-6 lg:px-8">
    <div class="max-w-5xl mx-auto flex justify-center">
      <div class="inline-flex items-center bg-white border border-gray-200 rounded-xl p-1 gap-1">
        <button
          id="billing-monthly"
          class="px-5 py-2 rounded-lg text-sm font-semibold transition-all duration-200 bg-[var(--color-forest)] text-white"
        >
          Monthly
        </button>
        <button
          id="billing-annual"
          class="px-5 py-2 rounded-lg text-sm font-semibold transition-all duration-200 text-[var(--color-stone)] hover:text-[var(--color-charcoal)]"
        >
          Annual
        </button>
      </div>
    </div>
  </section>

  <!-- Pricing cards -->
  <section class="bg-[var(--color-cream)] py-12 px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">

        <PricingCard
          tier="Starter"
          priceMonthly="\u20ac10"
          priceAnnualMonthly="\u20ac8.33"
          priceAnnual="\u20ac100"
          periodLabel="/month"
          yearLabel="/year"
          staffLimit="Up to 15 staff \u00b7 1 location"
          features={starterFeatures}
          cta="Start free \u2192"
          ctaHref="/en/sign-up?plan=starter"
        />

        <PricingCard
          tier="Pro"
          priceMonthly="\u20ac20"
          priceAnnualMonthly="\u20ac16.67"
          priceAnnual="\u20ac200"
          periodLabel="/month"
          yearLabel="/year"
          staffLimit="Up to 25 staff \u00b7 multiple locations"
          features={proFeatures}
          cta="Try Pro free \u2192"
          ctaHref="/en/sign-up?plan=pro"
          highlighted={true}
          badge="Most popular"
        />

        <PricingCard
          tier="Business"
          priceMonthly="\u20ac50"
          priceAnnualMonthly="\u20ac41.67"
          priceAnnual="\u20ac500"
          periodLabel="/month"
          yearLabel="/year"
          staffLimit="25+ staff \u00b7 multiple locations"
          features={businessFeatures}
          cta="Try Business free \u2192"
          ctaHref="/en/sign-up?plan=business"
        />
      </div>
    </div>
  </section>

  <!-- What's always free callout -->
  <section class="bg-white py-14 px-6 lg:px-8">
    <div class="max-w-2xl mx-auto">
      <div class="bg-[#E8F5EE] border border-[var(--color-forest)]/20 rounded-2xl p-8 text-center">
        <div class="w-12 h-12 bg-[var(--color-forest)] rounded-xl flex items-center justify-center mx-auto mb-4">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <h3 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-3">A free month first</h3>
        <p class="text-[var(--color-charcoal)] leading-relaxed">
          <strong>Every plan starts with a free month</strong>, no payment details needed. After that you decide whether to continue — nothing is charged automatically. No per-employee pricing, no surprise invoices.
        </p>
      </div>
    </div>
  </section>

  <!-- Competitive math -->
  <section class="bg-white py-12 px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
      <div class="bg-[var(--color-cream)] rounded-2xl p-8">
        <p class="text-xs font-semibold uppercase tracking-wider text-[var(--color-stone)] mb-4">The maths</p>
        <p class="text-[var(--color-charcoal)] text-lg leading-relaxed mb-3">
          Most scheduling software charges <strong>€2.50–€4 per staff member per month.</strong>
        </p>
        <p class="text-[var(--color-charcoal)] text-lg leading-relaxed">
          With Gedekt, a team of 25 pays a total of <strong class="text-[var(--color-forest)]">€20/month</strong> — that's <strong class="text-[var(--color-forest)]">€0.80 per person.</strong>
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-[var(--color-cream)] py-20 px-6 lg:px-8">
    <div class="max-w-2xl mx-auto">
      <SectionHeading title="Pricing questions" align="center" />
      <div class="bg-[var(--color-amber)]/10 border border-[var(--color-amber)]/30 rounded-xl px-6 py-4 mb-6">
        <p class="font-semibold text-[var(--color-charcoal)] text-sm mb-1">None of the plans quite fit?</p>
          <p class="text-[var(--color-stone)] text-sm leading-relaxed">
            Seasonal business, just over a limit, or something else? Let us know — we'll work out a rate that works for you.<br /><a href="/en/contact" class="text-[var(--color-forest)] font-semibold hover:underline">Get in touch →</a>
          </p>
      </div>
      <div class="space-y-3" id="faq-list">
        {faq.map((item, i) => (
          <div class="bg-white rounded-xl border border-gray-100 overflow-hidden">
            <button
              class="w-full text-left px-6 py-4 flex items-center justify-between font-medium text-[var(--color-charcoal)] hover:text-[var(--color-forest)] transition-colors"
              aria-expanded="false"
              data-faq-btn
            >
              {item.q}
              <svg class="w-5 h-5 shrink-0 transition-transform duration-200 text-[var(--color-stone)]" viewBox="0 0 20 20" fill="currentColor" data-chevron>
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
            <div class="px-6 pb-0 max-h-0 overflow-hidden transition-all duration-300" data-faq-body>
              <p class="text-[var(--color-stone)] pb-4 leading-relaxed">{item.a}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="bg-[var(--color-forest)] py-20 px-6 lg:px-8">
    <div class="max-w-2xl mx-auto text-center text-white">
      <h2 class="font-display font-bold text-3xl mb-4">Ready to try it?</h2>
      <p class="text-white/80 mb-8">First month free, then from €10/month. No long-term contract. Set up your first schedule today.</p>
      <Button href="/en/sign-up" variant="secondary" size="lg">Get started →</Button>
    </div>
  </section>

</BaseLayout>

<script>
  // Billing toggle
  const monthlyBtn = document.getElementById("billing-monthly");
  const annualBtn = document.getElementById("billing-annual");
  const monthlyEls = document.querySelectorAll<HTMLElement>('[data-billing="monthly"]');
  const annualEls = document.querySelectorAll<HTMLElement>('[data-billing="annual"]');

  function setBilling(annual: boolean) {
    monthlyEls.forEach((el) => el.classList.toggle("hidden", annual));
    annualEls.forEach((el) => el.classList.toggle("hidden", !annual));
    if (annual) {
      monthlyBtn?.classList.remove("bg-[var(--color-forest)]", "text-white");
      monthlyBtn?.classList.add("text-[var(--color-stone)]");
      annualBtn?.classList.add("bg-[var(--color-forest)]", "text-white");
      annualBtn?.classList.remove("text-[var(--color-stone)]");
    } else {
      annualBtn?.classList.remove("bg-[var(--color-forest)]", "text-white");
      annualBtn?.classList.add("text-[var(--color-stone)]");
      monthlyBtn?.classList.add("bg-[var(--color-forest)]", "text-white");
      monthlyBtn?.classList.remove("text-[var(--color-stone)]");
    }
  }

  monthlyBtn?.addEventListener("click", () => setBilling(false));
  annualBtn?.addEventListener("click", () => setBilling(true));

  document.querySelectorAll<HTMLButtonElement>("[data-faq-btn]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const body = btn.nextElementSibling as HTMLElement;
      const chevron = btn.querySelector<SVGElement>("[data-chevron]");
      const isOpen = btn.getAttribute("aria-expanded") === "true";

      if (isOpen) {
        btn.setAttribute("aria-expanded", "false");
        body.style.maxHeight = "0";
        chevron?.classList.remove("rotate-180");
      } else {
        btn.setAttribute("aria-expanded", "true");
        body.style.maxHeight = body.scrollHeight + "px";
        chevron?.classList.add("rotate-180");
      }
    });
  });
</script>
