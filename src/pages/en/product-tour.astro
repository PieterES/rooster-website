---
import { Image } from "astro:assets";
import adminDashboard from "../../assets/screenshots/admin-dashboard.png";
import adminHours from "../../assets/screenshots/admin-hours.png";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import DemoVideo from "../../components/DemoVideo.astro";
---

<BaseLayout
  title="Product tour: the scheduling app in action"
  description="See how Gedekt looks for staff and managers. From schedule planning to leave requests — short videos of the real app."
  lang="en"
>

  <!-- HERO -->
  <section class="bg-[var(--color-forest)] pt-32 pb-24 px-6 lg:px-8 text-center text-white">
    <div class="max-w-3xl mx-auto">
      <p class="text-[var(--color-amber)] font-semibold text-sm uppercase tracking-widest mb-4">Product tour</p>
      <h1 class="font-display font-bold text-4xl md:text-5xl mb-6 leading-tight">
        See it for yourself.
      </h1>
      <p class="text-white/80 text-lg leading-relaxed mb-10 max-w-xl mx-auto">
        From staff app to manager dashboard — this is what Gedekt looks like in practice.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="#staff" class="bg-white/10 hover:bg-white/20 border border-white/30 text-white font-semibold px-6 py-3 rounded-xl transition-colors">
          Staff App ↓
        </a>
        <a href="#manager" class="bg-[var(--color-amber)] hover:bg-[var(--color-amber-light)] text-white font-semibold px-6 py-3 rounded-xl transition-colors">
          Manager Dashboard ↓
        </a>
      </div>
    </div>
  </section>


  <!-- STAFF APP -->
  <section id="staff" class="bg-white py-24 px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
      <SectionHeading
        title="For your team: everything in their pocket"
        subtitle="Staff manage their availability, view their schedule, and submit swap requests — directly from the app."
        align="center"
      />
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-12 sm:gap-8 lg:gap-12 mt-14 max-w-5xl mx-auto">
        {[
          { name: "staff-schedule", label: "Schedule", desc: "Upcoming shifts, the team schedule and open shifts to pick up." },
          { name: "staff-availability", label: "Availability", desc: "Tick the shifts you can work each day — or prefer to." },
          { name: "staff-requests", label: "Swap & claim", desc: "Swap a shift with a colleague or pick up an open shift." },
        ].map((clip) => (
          <div class="flex flex-col items-center gap-5">
            <DemoVideo name={clip.name} lang="en" label={clip.label} device="phone" />
            <div class="text-center">
              <p class="font-display font-semibold text-[var(--color-charcoal)] text-sm">{clip.label}</p>
              <p class="text-[var(--color-stone)] text-xs mt-1 leading-relaxed max-w-[220px] mx-auto">{clip.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- MANAGER: SCHEDULE PLANNER -->
  <section id="manager" class="bg-[var(--color-cream)] py-24 px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-2xl mb-12">
        <p class="text-[var(--color-amber)] font-semibold text-sm uppercase tracking-widest mb-3">Manager dashboard</p>
        <h2 class="font-display font-bold text-3xl md:text-4xl text-[var(--color-charcoal)] mb-4 leading-tight">
          A complete schedule. In a few clicks.
        </h2>
        <p class="text-[var(--color-stone)] text-lg leading-relaxed mb-6">
          Apply your fixed assignments, let the scheduling engine fill the rest based on availability and contract hours, and publish with one click. Your team is notified right away.
        </p>
        <ul class="space-y-3">
          {[
            "Auto-generate based on availability and functions",
            "Live cost, hours and coverage at the top of the schedule",
            "Locked shifts are never changed by the auto-planner",
            "Publishing notifies everyone instantly",
          ].map((item) => (
            <li class="flex items-start gap-3 text-[var(--color-charcoal)] text-sm">
              <span class="w-5 h-5 rounded-full bg-[#E8F5EE] flex items-center justify-center text-[var(--color-forest)] shrink-0 mt-0.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <DemoVideo name="schedule" lang="en" label="Generating and publishing a weekly schedule" url="app.gedekt.com/schedule" class="shadow-2xl" />
    </div>
  </section>


  <!-- MANAGER: DEPARTMENTS -->
  <section class="bg-white py-24 px-6 lg:px-8">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <DemoVideo name="departments" lang="en" label="Creating a department with functions" url="app.gedekt.com/departments" class="order-2 lg:order-1" />
      <div class="order-1 lg:order-2">
        <p class="text-[var(--color-amber)] font-semibold text-sm uppercase tracking-widest mb-3">Departments & functions</p>
        <h2 class="font-display font-bold text-3xl text-[var(--color-charcoal)] mb-4 leading-tight">
          Set up your business.<br/>In a minute.
        </h2>
        <p class="text-[var(--color-stone)] leading-relaxed mb-6">
          Create departments such as Bar, Kitchen and Service, and give each one its own functions. The planner then knows exactly who can work which shift.
        </p>
        <ul class="space-y-3">
          {[
            "Unlimited departments and functions",
            "Link a department to a location",
            "Permissions per function, such as approving swaps",
          ].map((item) => (
            <li class="flex items-start gap-3 text-[var(--color-charcoal)] text-sm">
              <span class="w-5 h-5 rounded-full bg-[#E8F5EE] flex items-center justify-center text-[var(--color-forest)] shrink-0 mt-0.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>


  <!-- MANAGER: EMPLOYEES -->
  <section class="bg-[var(--color-cream)] py-24 px-6 lg:px-8">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
        <p class="text-[var(--color-amber)] font-semibold text-sm uppercase tracking-widest mb-3">Employees</p>
        <h2 class="font-display font-bold text-3xl text-[var(--color-charcoal)] mb-4 leading-tight">
          Your whole team.<br/>One overview.
        </h2>
        <p class="text-[var(--color-stone)] leading-relaxed mb-6">
          Add an employee, pick their department and function, and set contract hours and hourly rate. They get an invite to the app straight away.
        </p>
        <ul class="space-y-3">
          {[
            "Contract hours and hourly rate per employee at a glance",
            "Assign staff to multiple departments and functions",
            "Add a new employee in half a minute",
          ].map((item) => (
            <li class="flex items-start gap-3 text-[var(--color-charcoal)] text-sm">
              <span class="w-5 h-5 rounded-full bg-[#E8F5EE] flex items-center justify-center text-[var(--color-forest)] shrink-0 mt-0.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <DemoVideo name="employee" lang="en" label="Adding an employee" url="app.gedekt.com/employees" />
    </div>
  </section>


  <!-- MANAGER: FIXED SHIFTS -->
  <section class="bg-white py-24 px-6 lg:px-8">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <DemoVideo name="shifts" lang="en" label="Setting up shift types and fixed shifts" url="app.gedekt.com/fixed-shifts" class="order-2 lg:order-1" />
      <div class="order-1 lg:order-2">
        <p class="text-[var(--color-amber)] font-semibold text-sm uppercase tracking-widest mb-3">Shift types & fixed shifts</p>
        <h2 class="font-display font-bold text-3xl text-[var(--color-charcoal)] mb-4 leading-tight">
          Set it up once.<br/>Use it every week.
        </h2>
        <p class="text-[var(--color-stone)] leading-relaxed mb-6">
          Define your shifts with times and a minimum function. Drag a regular onto a shift and click the lock — the planner puts them on the schedule every week.
        </p>
        <ul class="space-y-3">
          {[
            "Shift times and minimum function per department",
            "Seasonal templates, for example summer and winter",
            "Drag and drop — eligible slots light up",
          ].map((item) => (
            <li class="flex items-start gap-3 text-[var(--color-charcoal)] text-sm">
              <span class="w-5 h-5 rounded-full bg-[#E8F5EE] flex items-center justify-center text-[var(--color-forest)] shrink-0 mt-0.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>


  <!-- MANAGER: DASHBOARD -->
  <section class="bg-[var(--color-cream)] py-24 px-6 lg:px-8">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
        <p class="text-[var(--color-amber)] font-semibold text-sm uppercase tracking-widest mb-3">Dashboard</p>
        <h2 class="font-display font-bold text-3xl text-[var(--color-charcoal)] mb-4 leading-tight">
          Everything at a glance.
        </h2>
        <p class="text-[var(--color-stone)] leading-relaxed mb-6">
          See at a glance how many pending actions there are, who's working today, and daily coverage for the week. Staff birthdays are shown too.
        </p>
        <ul class="space-y-3">
          {[
            "Pending claims, swap requests and corrections at the top",
            "Clock-in overview per day with departments",
            "Weekly coverage shown as a bar per day",
          ].map((item) => (
            <li class="flex items-start gap-3 text-[var(--color-charcoal)] text-sm">
              <span class="w-5 h-5 rounded-full bg-[#E8F5EE] flex items-center justify-center text-[var(--color-forest)] shrink-0 mt-0.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-xl overflow-hidden shadow-xl border border-gray-200">
        <div class="bg-[#f1f5f9] px-4 py-2.5 flex items-center gap-2 border-b border-gray-200">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-400"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
            <div class="w-3 h-3 rounded-full bg-green-400"></div>
          </div>
          <div class="flex-1 mx-4">
            <div class="bg-white rounded-md px-3 py-1 text-xs text-gray-400 font-mono">app.gedekt.com/dashboard</div>
          </div>
        </div>
        <div class="bg-gray-100">
          <Image src={adminDashboard} alt="Manager dashboard" class="w-full" loading="lazy" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 600px, 100vw" />
        </div>
      </div>
    </div>
  </section>


  <!-- MANAGER: HOURS -->
  <section class="bg-white py-24 px-6 lg:px-8">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="rounded-xl overflow-hidden shadow-xl border border-gray-200 order-2 lg:order-1">
        <div class="bg-[#f1f5f9] px-4 py-2.5 flex items-center gap-2 border-b border-gray-200">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-400"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
            <div class="w-3 h-3 rounded-full bg-green-400"></div>
          </div>
          <div class="flex-1 mx-4">
            <div class="bg-white rounded-md px-3 py-1 text-xs text-gray-400 font-mono">app.gedekt.com/hours</div>
          </div>
        </div>
        <div class="bg-gray-100">
          <Image src={adminHours} alt="Hours and corrections" class="w-full" loading="lazy" widths={[480, 800, 1200]} sizes="(min-width: 1024px) 600px, 100vw" />
        </div>
      </div>
      <div class="order-1 lg:order-2">
        <p class="text-[var(--color-amber)] font-semibold text-sm uppercase tracking-widest mb-3">Hours & Corrections</p>
        <h2 class="font-display font-bold text-3xl text-[var(--color-charcoal)] mb-4 leading-tight">
          Hours that add up.<br/>Every time.
        </h2>
        <p class="text-[var(--color-stone)] leading-relaxed mb-6">
          Manage worked hours per day and department. Staff can submit correction requests if they forgot to clock in or out — you approve or decline with one click.
        </p>
        <ul class="space-y-3">
          {[
            "Pending corrections shown at the top per day",
            "Clock-in and clock-out times per employee",
            "Break, staff lunch and dinner tracked automatically",
          ].map((item) => (
            <li class="flex items-start gap-3 text-[var(--color-charcoal)] text-sm">
              <span class="w-5 h-5 rounded-full bg-[#E8F5EE] flex items-center justify-center text-[var(--color-forest)] shrink-0 mt-0.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>


  <!-- MANAGER: REPORTS -->
  <section class="bg-[var(--color-cream)] py-24 px-6 lg:px-8">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
        <p class="text-[var(--color-amber)] font-semibold text-sm uppercase tracking-widest mb-3">Reports</p>
        <h2 class="font-display font-bold text-3xl text-[var(--color-charcoal)] mb-4 leading-tight">
          Insight into your labour costs.
        </h2>
        <p class="text-[var(--color-stone)] leading-relaxed mb-6">
          View monthly or custom reports of labour costs, net hours, and no-shows per employee. Filter by location and export for your administration.
        </p>
        <ul class="space-y-3">
          {[
            "Total hours, break and net hours per employee",
            "Labour costs including staff dinner deductions",
            "No-shows and contract deviations immediately visible",
          ].map((item) => (
            <li class="flex items-start gap-3 text-[var(--color-charcoal)] text-sm">
              <span class="w-5 h-5 rounded-full bg-[#E8F5EE] flex items-center justify-center text-[var(--color-forest)] shrink-0 mt-0.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <DemoVideo name="hours" lang="en" label="Reviewing monthly hours and labor cost" url="app.gedekt.com/reports" />
    </div>
  </section>


  <!-- MANAGER: REQUESTS -->
  <section class="bg-white py-24 px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
      <SectionHeading
        title="Requests without the messaging"
        subtitle="Staff submit everything through the app. You approve with one click."
        align="center"
      />
      <div class="max-w-4xl mx-auto mt-12">
        <DemoVideo name="requests" lang="en" label="Approving shift claims and swap requests" url="app.gedekt.com/swap-requests" />
        <p class="text-[var(--color-stone)] text-sm leading-relaxed text-center max-w-xl mx-auto mt-6">
          Staff claim open shifts or swap with each other. You see both sides, get a warning when a function doesn't match, and approve or decline.
        </p>
      </div>
    </div>
  </section>


  <!-- CTA -->
  <section class="bg-[var(--color-dark)] py-28 px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center text-white">
      <h2 class="font-display font-bold text-4xl md:text-5xl leading-tight mb-4">
        Ready to try it yourself?
      </h2>
      <p class="text-white/70 text-lg mb-10">
        Start today — your team set up in 15 minutes, your first schedule generated the same day.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="/en/contact" variant="secondary" size="lg">Book a demo →</Button>
        <Button href="/en/pricing" variant="ghost" size="lg">View pricing →</Button>
      </div>
    </div>
  </section>

</BaseLayout>
