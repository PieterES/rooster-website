---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";

const steps = [
  {
    number: "01",
    title: "Create your account",
    body: "Sign up, add your venue name, and invite your team — via email or a shareable link. No technical setup required.",
    qa: [
      { q: "Do I need to set up a database?", a: "No. Everything is hosted. You just sign up." },
    ],
  },
  {
    number: "02",
    title: "Configure your team",
    body: "Add departments (Bar, Kitchen, Floor), create staff ranks, and set fill rules for who can cover which role. This takes about 10 minutes for a typical venue.",
    qa: [],
  },
  {
    number: "03",
    title: "Staff set their availability",
    body: "Each team member marks their weekly availability template and flags any specific days they can't work. The engine reads this directly — no manual translation needed.",
    qa: [],
  },
  {
    number: "04",
    title: "Generate, review, and publish",
    body: "One click fills the schedule. Review it, drag-adjust anything you want to change, then publish. Your team gets push notifications instantly.",
    qa: [],
  },
];

const quickFAQ = [
  { q: "How long does initial setup take?", a: "Most venues are fully live in under 30 minutes. Adding staff, departments, ranks, and the first weekly template is straightforward." },
  { q: "Can I run it without the auto-generate feature?", a: "Yes. Starter plan includes a full schedule builder. Auto-generate is a Pro feature." },
  { q: "What if my team isn't tech-savvy?", a: "The employee app is intentionally minimal — staff see their shifts, mark availability, and request swaps. Three screens, that's it." },
];
---

<BaseLayout
  title="How It Works"
  description="From setup to first published schedule in under 30 minutes. Here's how HorecaRooster works."
>

  <!-- Hero -->
  <section class="bg-[var(--color-forest)] pt-32 pb-20 px-6 lg:px-8 text-white">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="font-display font-bold text-4xl md:text-5xl leading-tight mb-4">
        From setup to first schedule<br/>in under 30 minutes.
      </h1>
      <p class="text-white/80 text-lg leading-relaxed">
        No integrations required. No IT department needed. Just a venue, a team, and 30 minutes.
      </p>
    </div>
  </section>

  <!-- Steps — alternating layout -->
  <section class="bg-white py-20 px-6 lg:px-8">
    <div class="max-w-5xl mx-auto space-y-24">
      {steps.map((step, i) => (
        <div class:list={["flex flex-col md:flex-row gap-12 items-center", i % 2 === 1 && "md:flex-row-reverse"]}>
          <!-- Text side -->
          <div class="flex-1">
            <div class="font-display font-bold text-7xl text-[var(--color-amber)] opacity-20 leading-none select-none mb-2">
              {step.number}
            </div>
            <h2 class="font-display font-bold text-2xl md:text-3xl text-[var(--color-charcoal)] mb-3 -mt-4">{step.title}</h2>
            <p class="text-[var(--color-stone)] leading-relaxed text-lg mb-4">{step.body}</p>
            {step.qa.map((qa) => (
              <div class="bg-[var(--color-cream)] rounded-xl p-4 mt-3">
                <p class="text-sm font-semibold text-[var(--color-charcoal)] mb-1">{qa.q}</p>
                <p class="text-sm text-[var(--color-stone)]">{qa.a}</p>
              </div>
            ))}
          </div>
          <!-- Visual placeholder -->
          <div class="flex-1 w-full">
            <div class="bg-stone-100 rounded-2xl aspect-video flex items-center justify-center">
              <div class="text-center">
                <div class="font-display font-bold text-6xl text-stone-300 mb-2">{step.number}</div>
                <p class="text-stone-400 text-sm">{step.title}</p>
                <!-- Placeholder for real screenshot -->
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Quick FAQ -->
  <section class="bg-[var(--color-cream)] py-20 px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-8 text-center">Quick answers</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {quickFAQ.map((item) => (
          <div class="bg-white rounded-2xl p-6 border border-gray-100">
            <p class="font-semibold text-[var(--color-charcoal)] mb-2 text-sm">{item.q}</p>
            <p class="text-[var(--color-stone)] text-sm leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[var(--color-dark)] py-20 px-6 lg:px-8">
    <div class="max-w-2xl mx-auto text-center text-white">
      <h2 class="font-display font-bold text-3xl mb-4">Sounds simple? It is.</h2>
      <p class="text-white/70 mb-8">Start for free — no credit card, no setup fee.</p>
      <Button href="https://app.rooster-maker.app" variant="secondary" size="lg">Start for free →</Button>
    </div>
  </section>

</BaseLayout>
