---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import Button from "../../components/Button.astro";
import DemoVideo from "../../components/DemoVideo.astro";
import { demos, demoBySlug, demoHref } from "../../data/demos";

const steps = [
  {
    number: "01",
    title: "Set up your business",
    body: "Create an account, add your departments (Bar, Kitchen, Service) and give them functions. No technical setup, no IT department.",
    qa: [{ q: "Do I need to set up a database?", a: "No. Everything is hosted. You just sign up." }],
    demo: "departments-and-functions",
  },
  {
    number: "02",
    title: "Add your team",
    body: "Add employees with their department, function, contract hours and hourly rate. They get an invite to the app straight away.",
    qa: [],
    demo: "adding-an-employee",
  },
  {
    number: "03",
    title: "Staff set their availability",
    body: "Each team member ticks the shifts they can — or prefer to — work in the app. The engine reads this directly, no manual translation needed.",
    qa: [],
    demo: "staff-app",
    clip: "staff-availability",
  },
  {
    number: "04",
    title: "Generate, review, and publish",
    body: "One click fills the schedule. Review it, drag-adjust anything you want to change, then publish. Your team is notified instantly.",
    qa: [],
    demo: "creating-a-schedule",
  },
];

const quickFAQ = [
  { q: "How long does initial setup take?", a: "Most venues are fully live in under 30 minutes. Adding staff, departments, ranks, and the first weekly template is straightforward." },
  { q: "Can I run it without the auto-generate feature?", a: "Yes. Starter plan includes a full schedule builder. Auto-generate is a Pro feature." },
  { q: "What if my team isn't tech-savvy?", a: "The employee app is intentionally minimal — staff see their shifts, mark availability, and request swaps. Three screens, that's it." },
];

const features = [
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14"/><path d="M15.54 8.46a5 5 0 010 7.07M8.46 8.46a5 5 0 000 7.07"/></svg>`,
    title: "Smart Fill Engine",
    demo: "creating-a-schedule",
    hook: "The only scheduling tool that knows who can cover what — not just who's free.",
    bullets: [
      "Fills each shift with the most eligible employee based on department, rank, preference, and availability",
      "Set your own fill rules: a Bar Manager can fill Bartender shifts; not the other way around",
      "Prevents illegal scheduling: no Sunday closer working Monday open",
    ],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01"/></svg>`,
    title: "Availability Management",
    demo: "staff-app",
    hook: "Templates that staff actually update — because the system actually respects them.",
    bullets: [
      "Weekly availability templates that persist until changed — no re-entering every week",
      "One-off date overrides so staff can block specific days without breaking their template",
      "Manager sees unresolved availability gaps before generating, not after",
    ],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 9l4 4 10-10"/><rect x="3" y="3" width="18" height="18" rx="2"/></svg>`,
    title: "Online Schedule Editing",
    demo: "fixed-shifts",
    hook: "The engine suggests; you decide. Full manual override with zero friction.",
    bullets: [
      "The system validates and warns on conflicts but doesn't block",
      "Locked assignments survive re-generation so the engine works around them",
      "Live conflict indicators: rest time violations, double-bookings, cross-department mismatches shown inline",
      "See at a glance who fits which slot — based on role, department, and contracted hours",
      "Day and shift-type preferences per employee visible while scheduling, so you always know who prefers mornings or evenings",
      "Real-time headcount per shift: see how many employees are available before assigning a slot",
    ],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>`,
    title: "Shift Swaps & Open Shifts",
    demo: "claims-and-swaps",
    hook: "Staff sort out swaps themselves. You just approve.",
    bullets: [
      "Employee requests swap with a specific colleague; both must confirm; manager approves or denies",
      "Open shift claiming: publish an uncovered slot; eligible staff can claim it",
      "Clear communication — no more 'I thought you sorted that with Joost'",
    ],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>`,
    title: "Leave & Absence Management",
    hook: "One place for leave requests, sick days, and time-off — connected to the schedule.",
    bullets: [
      "Employees submit leave requests from the app; manager approves in one tap",
      "Approved leave auto-blocks the employee for scheduling on those dates",
      "Hours tracking integrates with leave for accurate weekly totals",
    ],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    title: "Clock In/Out & Hours Tracking",
    demo: "hours-and-labour-cost",
    hook: "Know exactly who worked, when, and how many hours — without spreadsheets.",
    bullets: [
      "Employees clock in via the app; timestamps recorded instantly",
      "Correction requests for missed shifts — manager approves inline",
      "Weekly hours summary per employee, with automatic flagging of too many or too few hours",
    ],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>`,
    title: "Employee Self-Service",
    demo: "staff-app",
    hook: "Your staff don't need training. They check shifts the way they check everything — on their phone.",
    bullets: [
      "Installable app works on any device",
      "Push notifications for new schedules, swap approvals, and shift changes",
      "Employees see their week at a glance, request changes, submit availability — no login friction",
    ],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>`,
    title: "Automated Reminders & Scheduled Publishing",
    hook: "Set it once. The system nudges your team and publishes the schedule on your schedule.",
    bullets: [
      "Set a fixed time for staff to automatically receive a reminder to submit their availability — weekly, on the day and time you choose",
      "Configure an automated generate-and-publish moment: the system builds the schedule and notifies everyone without you lifting a finger",
      "Employees receive a push notification and email the moment the schedule goes live — no group messages",
    ],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 12l2 2 4-4"/></svg>`,
    title: "Task Lists & Checklists",
    hook: "Always clear what needs doing — and who did it.",
    bullets: [
      "Create recurring checklists per shift: opening checks, closing procedures, and cleaning schedules",
      "Staff tick off tasks in the app; managers see in real time which tasks are completed",
      "Task history per shift so you never have to wonder if the fridge was checked",
    ],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>`,
    title: "Multi-Department & Role Configuration",
    demo: "departments-and-functions",
    hook: "Two departments or twelve — the structure adapts to your venue, not the other way around.",
    bullets: [
      "Create departments (Bar, Kitchen, Floor, Security) with custom shift types per department, complete with their own rules and restrictions",
      "Define ranks within departments with fill rules: who can cover whose role in a pinch",
      "Per-department scheduling so kitchen and bar managers own their own view",
    ],
  },
];

---

<BaseLayout
  title="How It Works"
  description="From setup to first published schedule in under 30 minutes. See in short videos how Gedekt works — and everything it includes."
>

  <!-- Hero -->
  <section class="bg-[var(--color-forest)] pt-32 pb-20 px-6 lg:px-8 text-white">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="font-display font-bold text-4xl md:text-5xl leading-tight mb-4">
        From setup to first schedule<br/>in under 30 minutes.
      </h1>
      <p class="text-white/80 text-lg leading-relaxed">
        No integrations required. No IT department needed. Just a venue, a team, and 30 minutes.
      </p>
    </div>
  </section>

  <!-- Steps, each with its demo clip -->
  <section class="bg-white py-20 px-6 lg:px-8">
    <div class="max-w-6xl mx-auto space-y-24">
      {steps.map((step, i) => {
        const demo = demoBySlug(step.demo, "en")!;
        return (
          <div class:list={["flex flex-col md:flex-row gap-12 items-center", i % 2 === 1 && "md:flex-row-reverse"]}>
            <div class="flex-1">
              <div class="font-display font-bold text-7xl text-[var(--color-amber)] opacity-20 leading-none select-none mb-2">{step.number}</div>
              <h2 class="font-display font-bold text-2xl md:text-3xl text-[var(--color-charcoal)] mb-3 -mt-4">{step.title}</h2>
              <p class="text-[var(--color-stone)] leading-relaxed text-lg mb-4">{step.body}</p>
              {step.qa.map((qa) => (
                <div class="bg-[var(--color-cream)] rounded-xl p-4 mt-3 mb-4">
                  <p class="text-sm font-semibold text-[var(--color-charcoal)] mb-1">{qa.q}</p>
                  <p class="text-sm text-[var(--color-stone)]">{qa.a}</p>
                </div>
              ))}
              <a href={demoHref(demo, "en")} class="inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-forest)] hover:text-[var(--color-amber)] transition-colors">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="6 4 20 12 6 20 6 4"/></svg>
                Watch the demo
              </a>
            </div>
            <div class="flex-1 w-full">
              {demo.device === "phone" ? (
                <DemoVideo name={step.clip ?? demo.clips[0].name} lang="en" label={step.title} device="phone" />
              ) : (
                <DemoVideo name={demo.clips[0].name} lang="en" label={step.title} url={demo.url?.en} />
              )}
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- Demo's -->
  <section class="bg-[var(--color-cream)] py-16 px-6 lg:px-8">
    <div class="max-w-5xl mx-auto text-center">
      <p class="text-[var(--color-amber)] font-semibold text-sm uppercase tracking-widest mb-2">More demos</p>
      <p class="text-[var(--color-stone)] text-sm mb-6">Short videos of the real app — no mockups.</p>
      <div class="flex flex-wrap justify-center gap-3">
        {demos.map((d) => (
          <a href={demoHref(d, "en")} class="inline-flex items-center gap-2 bg-white border border-gray-200 rounded-full px-4 py-2 text-sm font-medium text-[var(--color-charcoal)] hover:border-[var(--color-forest)] hover:text-[var(--color-forest)] transition-colors">
            <svg class="w-3 h-3 text-[var(--color-forest)]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="6 4 20 12 6 20 6 4"/></svg>
            {d.menuLabel.en}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Feature grid -->
  <section id="features" class="bg-white py-20 px-6 lg:px-8 scroll-mt-16">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-2xl mx-auto text-center mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl text-[var(--color-charcoal)] leading-tight mb-4">Everything that's included</h2>
        <p class="text-lg text-[var(--color-stone)] leading-relaxed">Every feature was designed around how a real horeca venue actually operates.</p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {features.map((f) => (
          <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 p-6 rounded-2xl border border-gray-100 hover:border-[var(--color-forest)]/20 hover:shadow-md transition-all duration-300">
            <div class="w-12 h-12 bg-[#E8F5EE] rounded-xl flex items-center justify-center text-[var(--color-forest)] shrink-0" set:html={f.icon} />
            <div class="text-center sm:text-left">
              <h3 class="font-display font-semibold text-lg text-[var(--color-charcoal)] mb-1">{f.title}</h3>
              <p class="text-[var(--color-amber)] text-sm font-medium mb-3">{f.hook}</p>
              <ul class="space-y-1.5">
                {f.bullets.map((b) => (
                  <li class="flex items-start gap-2 text-sm text-[var(--color-stone)]">
                    <svg class="w-4 h-4 text-[var(--color-forest)] mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    {b}
                  </li>
                ))}
              </ul>
              {f.demo && (
                <a href={demoHref(demoBySlug(f.demo, "en")!, "en")} class="inline-flex items-center gap-1.5 mt-4 text-sm font-semibold text-[var(--color-forest)] hover:text-[var(--color-amber)] transition-colors">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="6 4 20 12 6 20 6 4"/></svg>
                  See how it works
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-[var(--color-cream)] py-20 px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-8 text-center">Quick answers</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {quickFAQ.map((item) => (
          <div class="bg-white rounded-2xl p-6 border border-gray-100">
            <p class="font-semibold text-[var(--color-charcoal)] mb-2 text-sm">{item.q}</p>
            <p class="text-[var(--color-stone)] text-sm leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Always improving -->
  <section class="bg-[var(--color-forest)] py-16 px-6 lg:px-8 text-white">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="font-display font-bold text-2xl md:text-3xl mb-4">Always building.</h2>
      <p class="text-white/80 text-lg leading-relaxed mb-8">
        Gedekt is constantly being improved, updated, and expanded with new functionality. We're a small team that moves fast — and our users feel it.
      </p>
      <div class="bg-white/10 border border-white/20 rounded-2xl p-6 text-left max-w-2xl mx-auto mb-6">
        <p class="text-white/60 text-xs font-semibold uppercase tracking-wider mb-3">Coming soon</p>
        <ul class="space-y-4">
          <li class="flex items-start gap-3 text-white/85">
            <span class="text-[var(--color-amber)] font-bold mt-0.5 shrink-0">→</span>
            <span><strong class="text-white">More integrations</strong> — Direct connections with payroll processing and POS systems.</span>
          </li>
        </ul>
      </div>
      <p class="text-white/60 text-sm">Have an idea or request? We're listening. <a href="/en/contact" class="text-[var(--color-amber)] underline hover:text-white transition-colors">Send us a message →</a></p>
    </div>
  </section>


  <!-- CTA -->
  <section class="bg-[var(--color-dark)] py-20 px-6 lg:px-8">
    <div class="max-w-2xl mx-auto text-center text-white">
      <h2 class="font-display font-bold text-3xl md:text-4xl mb-4">Ready to try it?</h2>
      <p class="text-white/70 mb-8">Free for teams of up to 5. No credit card required.</p>
      <Button href="https://app.gedekt.com" variant="secondary" size="lg">Start for free →</Button>
    </div>
  </section>

</BaseLayout>
