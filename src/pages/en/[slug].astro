---
import GuidePage from "../../components/GuidePage.astro";
import { guidesFor, type Guide } from "../../data/guides";

export function getStaticPaths() {
  return guidesFor("en").map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props as { guide: Guide };
---

<GuidePage guide={guide} />
