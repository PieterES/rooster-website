---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Button from "../components/Button.astro";

const features = [
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 010 14.14M4.93 4.93a10 10 0 000 14.14"/><path d="M15.54 8.46a5 5 0 010 7.07M8.46 8.46a5 5 0 000 7.07"/></svg>`,
    title: "Slimme Inplanmotor",
    hook: "Het enige planningssysteem dat weet wie wat kan doen — niet alleen wie er vrij is.",
    bullets: [
      "Vult elke dienst in met de meest geschikte medewerker op basis van afdeling, rang en beschikbaarheid",
      "Respecteert invulregels: een barmanager kan barteniderplekken opvullen; het systeem weet dit automatisch",
      "Voorkomt ongeldige planning: geen zondagavondsluiters ook op maandagochtend, geen opeenvolgende nachtdiensten",
    ],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01"/></svg>`,
    title: "Beschikbaarheidsbeheer",
    hook: "Templates die medewerkers daadwerkelijk bijhouden — omdat het systeem er ook echt mee rekening houdt.",
    bullets: [
      "Wekelijkse beschikbaarheidstemplates die automatisch doorlopen totdat ze worden gewijzigd",
      "Losse uitzonderingen voor specifieke datums zonder de template te verstoren",
      "Manager ziet onopgeloste beschikbaarheidsgaten vóór het genereren, niet erna",
    ],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 9l4 4 10-10"/><rect x="3" y="3" width="18" height="18" rx="2"/></svg>`,
    title: "Drag-and-drop Roosterbewerking",
    hook: "Het systeem stelt voor; jij beslist. Volledig handmatig aanpassen zonder gedoe.",
    bullets: [
      "Sleep elke medewerker naar een dienst — het systeem controleert en waarschuwt bij conflicten maar blokkeert niet",
      "Vergrendelde toewijzingen blijven staan bij opnieuw genereren",
      "Live conflictindicatoren: rusttijdschendingen, dubbele boekingen en afdelingsmismatches direct zichtbaar",
    ],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>`,
    title: "Dienstwissel & Open Diensten",
    hook: "Medewerkers regelen wisselingen onderling. Jij keurt alleen goed.",
    bullets: [
      "Medewerker vraagt wisseling aan bij een collega; beiden bevestigen; manager keurt goed of af",
      "Open diensten: publiceer een onbezette plek; in aanmerking komende medewerkers kunnen hem claimen",
      "Volledige audittrail — geen onduidelijkheid meer over 'ik dacht dat jij dat met Joost had afgesproken'",
    ],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>`,
    title: "Verlof- en Verzuimbeheer",
    hook: "Eén plek voor verlofaanvragen, ziekmeldingen en vrije dagen — direct gekoppeld aan het rooster.",
    bullets: [
      "Medewerkers dienen verlofaanvragen in via de app; manager keurt met één tik goed",
      "Goedgekeurd verlof blokkeert de medewerker automatisch bij het inplannen",
      "Urenregistratie integreert met verlof voor nauwkeurige weektotalen",
    ],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
    title: "In- en Uitklokken & Urenregistratie",
    hook: "Weet precies wie werkte, wanneer en hoeveel uur — zonder spreadsheets.",
    bullets: [
      "Medewerkers klokken in/uit via hun telefoon; tijdstempels worden direct opgeslagen",
      "Correctieverzoeken voor gemiste prikbeurten — manager keurt inline goed",
      "Wekelijks urenoverzicht per medewerker, met automatische signalering van overschrijdingen",
    ],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>`,
    title: "Medewerker Self-Service (PWA + Android)",
    hook: "Je medewerkers hebben geen training nodig. Ze checken diensten zoals ze alles checken — op hun telefoon.",
    bullets: [
      "Installeerbare Progressive Web App werkt op elk apparaat; Android-wrapper beschikbaar",
      "Pushmeldingen voor nieuwe roosters, wisselgoedkeuringen en dienstwijzigingen",
      "Medewerkers zien hun week in één oogopslag, vragen wijzigingen aan, geven beschikbaarheid op — zonder inloggedoe",
    ],
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>`,
    title: "Meerdere Afdelingen & Rolconfiguratie",
    hook: "Twee afdelingen of twaalf — de structuur past zich aan jouw locatie aan, niet andersom.",
    bullets: [
      "Maak afdelingen aan (Bar, Keuken, Bediening, Gastvrouw) met eigen diensttypen per afdeling",
      "Definieer rangen binnen afdelingen met invulregels: wie kan wiens rol in noodgevallen overnemen",
      "Per-afdeling roosteren zodat bar- en keukenmanagers hun eigen overzicht hebben",
    ],
  },
];

const comparison = [
  { feature: "Horeca-specifieke invulregels", us: true, them: false },
  { feature: "Nederlandse interface", us: true, them: false },
  { feature: "Vaste maandprijs (geen kosten per medewerker)", us: true, them: false },
  { feature: "EU-dataopslag", us: true, them: false },
  { feature: "Gratis tier voor kleine teams (≤5 medewerkers)", us: true, them: "Beperkt" },
  { feature: "Geen langetermijncontracten", us: true, them: true },
  { feature: "Mobiele PWA", us: true, them: true },
];
---

<BaseLayout
  title="Functies"
  description="Elke functie gebouwd voor echte horecabedrijven. Slimme inplanmotor, beschikbaarheidsbeheer, dienstwisselingen, urenregistratie en meer."
  lang="nl"
>

  <!-- Hero -->
  <section class="bg-[var(--color-cream)] pt-32 pb-16 px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="font-display font-bold text-4xl md:text-5xl text-[var(--color-charcoal)] leading-tight mb-4">
        Elke functie gebouwd voor echte locaties.
      </h1>
      <p class="text-lg text-[var(--color-stone)] leading-relaxed">
        HorecaRooster is geen generieke plantool met een horecalaagje. Elke functie is ontworpen rond hoe een echte horecalocatie daadwerkelijk werkt.
      </p>
    </div>
  </section>

  <!-- Functieraster -->
  <section class="bg-white py-16 px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {features.map((f) => (
          <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 p-6 rounded-2xl border border-gray-100 hover:border-[var(--color-forest)]/20 hover:shadow-md transition-all duration-300">
            <div class="w-12 h-12 bg-[#E8F5EE] rounded-xl flex items-center justify-center text-[var(--color-forest)] shrink-0" set:html={f.icon} />
            <div class="text-center sm:text-left">
              <h3 class="font-display font-semibold text-lg text-[var(--color-charcoal)] mb-1">{f.title}</h3>
              <p class="text-[var(--color-amber)] text-sm font-medium mb-3">{f.hook}</p>
              <ul class="space-y-1.5">
                {f.bullets.map((b) => (
                  <li class="flex items-start gap-2 text-sm text-[var(--color-stone)]">
                    <svg class="w-4 h-4 text-[var(--color-forest)] mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    {b}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Altijd in ontwikkeling -->
  <section class="bg-[var(--color-forest)] py-16 px-6 lg:px-8 text-white">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="font-display font-bold text-2xl md:text-3xl mb-4">We zijn constant bezig.</h2>
      <p class="text-white/80 text-lg leading-relaxed mb-8">
        HorecaRooster wordt continu verbeterd, bijgewerkt en uitgebreid met nieuwe functionaliteit. We zijn een klein team dat snel kan schakelen — en dat merken onze gebruikers.
      </p>
      <div class="bg-white/10 border border-white/20 rounded-2xl p-6 text-left max-w-2xl mx-auto mb-6">
        <p class="text-white/60 text-xs font-semibold uppercase tracking-wider mb-3">Binnenkort</p>
        <ul class="space-y-4">
          <li class="flex items-start gap-3 text-white/85">
            <span class="text-[var(--color-amber)] font-bold mt-0.5 shrink-0">→</span>
            <span><strong class="text-white">Taaklists &amp; checklists</strong> — Bijhouden wat er gedaan moet worden en wanneer het klaar is. Denk aan schoonmaakschema's, openings- en sluitingschecks en terugkerende taken per dienst.</span>
          </li>
          <li class="flex items-start gap-3 text-white/85">
            <span class="text-[var(--color-amber)] font-bold mt-0.5 shrink-0">→</span>
            <span><strong class="text-white">Meer integraties</strong> — Directe koppelingen met salarisverwerking en kassasystemen.</span>
          </li>
        </ul>
      </div>
      <p class="text-white/60 text-sm">Heb je een idee of wens? We luisteren. <a href="/contact" class="text-[var(--color-amber)] underline hover:text-white transition-colors">Stuur ons een berichtje →</a></p>
    </div>
  </section>


  <!-- Vergelijkingstabel -->
  <section class="bg-[var(--color-cream)] py-20 px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
      <SectionHeading
        title="HorecaRooster vs. generieke planningsapps"
        subtitle="Zonder de enterprise-prijskaart."
        align="center"
      />
      <div class="bg-white rounded-2xl border border-gray-100 overflow-hidden shadow-sm">
        <div class="grid grid-cols-3 bg-[var(--color-forest)] text-white text-sm font-semibold px-6 py-4">
          <div>Functie</div>
          <div class="text-center">HorecaRooster</div>
          <div class="text-center">Gemiddelde app</div>
        </div>
        {comparison.map((row, i) => (
          <div class:list={["grid grid-cols-3 px-6 py-4 text-sm border-t border-gray-50", i % 2 === 1 && "bg-gray-50/50"]}>
            <div class="text-[var(--color-charcoal)] font-medium">{row.feature}</div>
            <div class="text-center">
              {row.us === true ? (
                <span class="text-[var(--color-forest)] font-bold">✓</span>
              ) : (
                <span class="text-red-400">✗</span>
              )}
            </div>
            <div class="text-center">
              {row.them === true ? (
                <span class="text-[var(--color-forest)] font-bold">✓</span>
              ) : row.them === false ? (
                <span class="text-red-400">✗</span>
              ) : (
                <span class="text-[var(--color-stone)] text-xs">{row.them}</span>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[var(--color-dark)] py-20 px-6 lg:px-8">
    <div class="max-w-2xl mx-auto text-center text-white">
      <h2 class="font-display font-bold text-3xl md:text-4xl mb-4">Klaar om het te proberen?</h2>
      <p class="text-white/70 mb-8">Vanaf €10/maand. Geen jaarcontract vereist.</p>
      <Button href="https://app.rooster-maker.app" variant="secondary" size="lg">Aan de slag →</Button>
    </div>
  </section>

</BaseLayout>
