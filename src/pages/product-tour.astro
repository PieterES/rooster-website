---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import SectionHeading from "../components/SectionHeading.astro";
---

<BaseLayout
  title="De app in actie — HorecaRooster"
  description="Bekijk hoe HorecaRooster eruitziet voor medewerkers en beheerders. Van roosterplanning tot verlofaanvragen — live screenshots van de app."
  lang="nl"
>

  <!-- HERO -->
  <section class="bg-[var(--color-forest)] pt-32 pb-24 px-6 lg:px-8 text-center text-white">
    <div class="max-w-3xl mx-auto">
      <p class="text-[var(--color-amber)] font-semibold text-sm uppercase tracking-widest mb-4">Product tour</p>
      <h1 class="font-display font-bold text-4xl md:text-5xl mb-6 leading-tight">
        Zie het zelf.
      </h1>
      <p class="text-white/80 text-lg leading-relaxed mb-10 max-w-xl mx-auto">
        Van medewerkers-app tot beheerdersdashboard — dit is hoe HorecaRooster er in de praktijk uitziet.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="#medewerkers" class="bg-white/10 hover:bg-white/20 border border-white/30 text-white font-semibold px-6 py-3 rounded-xl transition-colors">
          Medewerkers App ↓
        </a>
        <a href="#beheerder" class="bg-[var(--color-amber)] hover:bg-[var(--color-amber-light)] text-white font-semibold px-6 py-3 rounded-xl transition-colors">
          Beheerder Dashboard ↓
        </a>
      </div>
    </div>
  </section>


  <!-- EMPLOYEE APP -->
  <section id="medewerkers" class="bg-white py-24 px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
      <SectionHeading
        title="Voor je team: alles in hun pocket"
        subtitle="Medewerkers beheren hun beschikbaarheid, bekijken hun rooster en dienen ruilverzoeken in — rechtstreeks vanuit de app."
        align="center"
      />
      <div class="grid grid-cols-2 gap-8 lg:gap-12 mt-14 max-w-3xl mx-auto">
        {[
          { src: "/screenshots/employee-dashboard.png", label: "Dashboard", desc: "Aankomende diensten, openstaande aanvragen en meldingen in één overzicht." },
          { src: "/screenshots/employee-availability.png", label: "Beschikbaarheid", desc: "Wekelijkse template plus losse uitzonderingen per dag instellen." },
          { src: "/screenshots/employee-schedule.png", label: "Rooster", desc: "Maand- en weekoverzicht van het volledige teamrooster." },
          { src: "/screenshots/employee-checklist.png", label: "Checklist", desc: "Terugkerende taken afvinken, per medewerker bijgehouden." },
        ].map((screen) => (
          <div class="flex flex-col items-center gap-4">
            <div class="w-full max-w-[360px] mx-auto rounded-2xl overflow-hidden border-4 border-gray-900 shadow-md">
              <img
                src={screen.src}
                alt={screen.label}
                class="w-full block"
                loading="lazy"
              />
            </div>
            <div class="text-center">
              <p class="font-display font-semibold text-[var(--color-charcoal)] text-sm">{screen.label}</p>
              <p class="text-[var(--color-stone)] text-xs mt-1 leading-relaxed max-w-[160px] mx-auto">{screen.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ADMIN: ROOSTERPLANNER -->
  <section id="beheerder" class="bg-[var(--color-cream)] py-24 px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-2xl mb-12">
        <p class="text-[var(--color-amber)] font-semibold text-sm uppercase tracking-widest mb-3">Beheerder dashboard</p>
        <h2 class="font-display font-bold text-3xl md:text-4xl text-[var(--color-charcoal)] mb-4 leading-tight">
          Jouw rooster. Volledig in controle.
        </h2>
        <p class="text-[var(--color-stone)] text-lg leading-relaxed mb-6">
          De roosterplanner geeft je een volledig weekoverzicht per afdeling. Sleep medewerkers naar diensten, zie direct wie beschikbaar is, en publiceer met één klik.
        </p>
        <ul class="space-y-3">
          {[
            "Kleurcodering per afdeling — Bar, Keuken, Bediening",
            "Beschikbare medewerkers direct zichtbaar onder het rooster",
            "Live kosten, uren en bezetting in de voettekst",
            "Vergrendelde diensten worden niet gewijzigd door de planner",
          ].map((item) => (
            <li class="flex items-start gap-3 text-[var(--color-charcoal)] text-sm">
              <span class="w-5 h-5 rounded-full bg-[#E8F5EE] flex items-center justify-center text-[var(--color-forest)] shrink-0 mt-0.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-xl overflow-hidden shadow-2xl border border-gray-200">
        <div class="bg-[#f1f5f9] px-4 py-2.5 flex items-center gap-2 border-b border-gray-200">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-400"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
            <div class="w-3 h-3 rounded-full bg-green-400"></div>
          </div>
          <div class="flex-1 mx-4">
            <div class="bg-white rounded-md px-3 py-1 text-xs text-gray-400 font-mono">app.rooster-maker.app/rooster</div>
          </div>
        </div>
        <div class="bg-gray-100 overflow-hidden max-h-[260px] md:max-h-none">
          <img
            src="/screenshots/admin-schedule.png"
            alt="HorecaRooster roosterplanner"
            class="w-full"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>


  <!-- ADMIN: MEDEWERKERS (alternating) -->
  <section class="bg-white py-24 px-6 lg:px-8">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="rounded-xl overflow-hidden shadow-xl border border-gray-200 order-2 lg:order-1">
        <div class="bg-[#f1f5f9] px-4 py-2.5 flex items-center gap-2 border-b border-gray-200">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-400"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
            <div class="w-3 h-3 rounded-full bg-green-400"></div>
          </div>
          <div class="flex-1 mx-4">
            <div class="bg-white rounded-md px-3 py-1 text-xs text-gray-400 font-mono">app.rooster-maker.app/medewerkers</div>
          </div>
        </div>
        <div class="bg-gray-100 min-h-[200px]">
          <img src="/screenshots/admin-employees.png" alt="Medewerkersoverzicht" class="w-full" loading="lazy" />
        </div>
      </div>
      <div class="order-1 lg:order-2">
        <p class="text-[var(--color-amber)] font-semibold text-sm uppercase tracking-widest mb-3">Medewerkers</p>
        <h2 class="font-display font-bold text-3xl text-[var(--color-charcoal)] mb-4 leading-tight">
          Je hele team.<br/>Eén overzicht.
        </h2>
        <p class="text-[var(--color-stone)] leading-relaxed mb-6">
          Naam, afdeling, functie en contracturen van iedereen op één plek. Zoek direct op naam of filter op afdeling om snel te vinden wie je zoekt.
        </p>
        <ul class="space-y-3">
          {[
            "Contracturen en uurloon per medewerker in één oogopslag",
            "Koppel medewerkers aan meerdere afdelingen en functies",
            "Nieuwe medewerker toevoegen met één klik",
          ].map((item) => (
            <li class="flex items-start gap-3 text-[var(--color-charcoal)] text-sm">
              <span class="w-5 h-5 rounded-full bg-[#E8F5EE] flex items-center justify-center text-[var(--color-forest)] shrink-0 mt-0.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>


  <!-- ADMIN: DASHBOARD -->
  <section class="bg-[var(--color-cream)] py-24 px-6 lg:px-8">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
        <p class="text-[var(--color-amber)] font-semibold text-sm uppercase tracking-widest mb-3">Dashboard</p>
        <h2 class="font-display font-bold text-3xl text-[var(--color-charcoal)] mb-4 leading-tight">
          Alles in één oogopslag.
        </h2>
        <p class="text-[var(--color-stone)] leading-relaxed mb-6">
          Zie in één oogopslag hoeveel openstaande acties er zijn, wie er vandaag werkt en hoe de bezetting er per dag uitziet. Verjaardagen van medewerkers worden ook weergegeven.
        </p>
        <ul class="space-y-3">
          {[
            "Openstaande claims, ruilverzoeken en correcties bovenaan",
            "Clock-in overzicht per dag met afdelingen",
            "Weekbezetting in één balk per dag",
          ].map((item) => (
            <li class="flex items-start gap-3 text-[var(--color-charcoal)] text-sm">
              <span class="w-5 h-5 rounded-full bg-[#E8F5EE] flex items-center justify-center text-[var(--color-forest)] shrink-0 mt-0.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-xl overflow-hidden shadow-xl border border-gray-200">
        <div class="bg-[#f1f5f9] px-4 py-2.5 flex items-center gap-2 border-b border-gray-200">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-400"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
            <div class="w-3 h-3 rounded-full bg-green-400"></div>
          </div>
          <div class="flex-1 mx-4">
            <div class="bg-white rounded-md px-3 py-1 text-xs text-gray-400 font-mono">app.rooster-maker.app/dashboard</div>
          </div>
        </div>
        <div class="bg-gray-100">
          <img src="/screenshots/admin-dashboard.png" alt="Beheerder dashboard" class="w-full" loading="lazy" />
        </div>
      </div>
    </div>
  </section>


  <!-- ADMIN: UREN -->
  <section class="bg-white py-24 px-6 lg:px-8">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="rounded-xl overflow-hidden shadow-xl border border-gray-200 order-2 lg:order-1">
        <div class="bg-[#f1f5f9] px-4 py-2.5 flex items-center gap-2 border-b border-gray-200">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-400"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
            <div class="w-3 h-3 rounded-full bg-green-400"></div>
          </div>
          <div class="flex-1 mx-4">
            <div class="bg-white rounded-md px-3 py-1 text-xs text-gray-400 font-mono">app.rooster-maker.app/uren</div>
          </div>
        </div>
        <div class="bg-gray-100">
          <img src="/screenshots/admin-hours.png" alt="Uren en correcties" class="w-full" loading="lazy" />
        </div>
      </div>
      <div class="order-1 lg:order-2">
        <p class="text-[var(--color-amber)] font-semibold text-sm uppercase tracking-widest mb-3">Uren & Correcties</p>
        <h2 class="font-display font-bold text-3xl text-[var(--color-charcoal)] mb-4 leading-tight">
          Uren die kloppen.<br/>Altijd.
        </h2>
        <p class="text-[var(--color-stone)] leading-relaxed mb-6">
          Beheer gewerkte uren per dag en afdeling. Medewerkers kunnen correctieverzoeken indienen als ze vergeten in of uit te klokken — jij keurt goed of af met één klik.
        </p>
        <ul class="space-y-3">
          {[
            "Openstaande urencorrecties bovenaan per dag",
            "Ingecheckte en uitgecheckte tijden per medewerker",
            "Pauze, personeelslunch en -diner bijgehouden",
          ].map((item) => (
            <li class="flex items-start gap-3 text-[var(--color-charcoal)] text-sm">
              <span class="w-5 h-5 rounded-full bg-[#E8F5EE] flex items-center justify-center text-[var(--color-forest)] shrink-0 mt-0.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>


  <!-- ADMIN: RAPPORTEN -->
  <section class="bg-[var(--color-cream)] py-24 px-6 lg:px-8">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
        <p class="text-[var(--color-amber)] font-semibold text-sm uppercase tracking-widest mb-3">Rapporten</p>
        <h2 class="font-display font-bold text-3xl text-[var(--color-charcoal)] mb-4 leading-tight">
          Inzicht in je loonkosten.
        </h2>
        <p class="text-[var(--color-stone)] leading-relaxed mb-6">
          Bekijk maandelijkse of aangepaste rapporten van arbeidskosten, netto uren en no-shows per medewerker. Filter op locatie en exporteer voor je administratie.
        </p>
        <ul class="space-y-3">
          {[
            "Totale uren, pauze en netto uren per medewerker",
            "Loonkosten inclusief personeelsdiner aftrek",
            "No-shows en contractafwijkingen direct zichtbaar",
          ].map((item) => (
            <li class="flex items-start gap-3 text-[var(--color-charcoal)] text-sm">
              <span class="w-5 h-5 rounded-full bg-[#E8F5EE] flex items-center justify-center text-[var(--color-forest)] shrink-0 mt-0.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-xl overflow-hidden shadow-xl border border-gray-200">
        <div class="bg-[#f1f5f9] px-4 py-2.5 flex items-center gap-2 border-b border-gray-200">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-400"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
            <div class="w-3 h-3 rounded-full bg-green-400"></div>
          </div>
          <div class="flex-1 mx-4">
            <div class="bg-white rounded-md px-3 py-1 text-xs text-gray-400 font-mono">app.rooster-maker.app/rapporten</div>
          </div>
        </div>
        <div class="bg-gray-100">
          <img src="/screenshots/admin-reports.png" alt="Rapporten" class="w-full" loading="lazy" />
        </div>
      </div>
    </div>
  </section>


  <!-- ADMIN: AANVRAGEN -->
  <section class="bg-white py-24 px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
      <SectionHeading
        title="Aanvragen zonder appen"
        subtitle="Medewerkers dienen alles in via de app. Jij keurt goed met één klik."
        align="center"
      />
      <div class="max-w-md mx-auto mt-12">
        {[
          {
            src: "/screenshots/admin-swaps.png",
            title: "Ruilverzoeken",
            desc: "Medewerkers vragen onderling om diensten te ruilen. Jij ziet beide kanten, voegt eventueel een opmerking toe en keurt goed of af.",
          },
        ].map((item) => (
          <div class="bg-[var(--color-cream)] rounded-2xl overflow-hidden border border-gray-100 shadow-sm">
            <div class="bg-[#f8fafc] border-b border-gray-100 px-3 py-2 flex items-center gap-1.5">
              <div class="w-2.5 h-2.5 rounded-full bg-red-400"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-yellow-400"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-green-400"></div>
            </div>
            <div class="bg-gray-50 min-h-[100px] overflow-hidden">
              <img src={item.src} alt={item.title} class="w-full" loading="lazy" />
            </div>
            <div class="p-6">
              <h3 class="font-display font-semibold text-[var(--color-charcoal)] mb-2">{item.title}</h3>
              <p class="text-[var(--color-stone)] text-sm leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- CTA -->
  <section class="bg-[var(--color-dark)] py-28 px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center text-white">
      <h2 class="font-display font-bold text-4xl md:text-5xl leading-tight mb-4">
        Klaar om het zelf te proberen?
      </h2>
      <p class="text-white/70 text-lg mb-10">
        Start vandaag — je team in 15 minuten ingericht, je eerste rooster dezelfde dag gegenereerd.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="/contact" variant="secondary" size="lg">Start een demo →</Button>
        <Button href="/prijzen" variant="ghost" size="lg">Bekijk prijzen →</Button>
      </div>
    </div>
  </section>

</BaseLayout>
