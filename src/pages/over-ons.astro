---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";

const values = [
  {
    title: "Eerlijk als standaard",
    body: "Geen verborgen kosten, geen dark patterns, geen enterprise-lokaas. Vaste prijzen, transparante functies — wat je op de prijspagina ziet is precies wat je betaalt.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  },
  {
    title: "Op menselijke schaal",
    body: "Gebouwd voor locaties waar de manager ook op de werkvloer staat. Elke ontwerpkeuze is gemaakt met een team van 12 in een café in gedachten, niet een hotelketen van 200 man.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>`,
  },
  {
    title: "EU-native",
    body: "Gegevens in de EU. Nederlandse en Engelse interface. Gebouwd voor de Nederlandse arbeidsmarkt. Geen nagedachte retrofit van een Amerikaans product.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>`,
  },
];
---

<BaseLayout
  title="Over ons"
  description="HorecaRooster — gebouwd door iemand die het chaos zelf heeft meegemaakt. Data-engineer, AI-specialist en voormalig vloermanager in de Utrechtse horeca."
  lang="nl"
>

  <!-- Hero -->
  <section class="bg-[var(--color-forest)] pt-32 pb-20 px-6 lg:px-8 text-white">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="font-display font-bold text-4xl md:text-5xl leading-tight mb-4">
        Gebouwd door iemand die het van twee kanten kent.
      </h1>
    </div>
  </section>

  <!-- Missie -->
  <section class="bg-[var(--color-cream)] py-20 px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-xl text-[var(--color-charcoal)] leading-relaxed">
        HorecaRooster bestaat omdat kleine Nederlandse horecabedrijven planningstools verdienen die echt passen bij hoe ze werken — geen afgezwakt enterprise-pakket en geen Silicon Valley-app die niet weet wat een CAO is.
      </p>
    </div>
  </section>

  <!-- Oprichtersectie -->
  <section class="bg-white py-20 px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <div class="flex flex-col md:flex-row gap-12 items-start">
        <!-- Avatar -->
        <div class="flex flex-col items-center gap-3 shrink-0">
          <div class="w-28 h-28 rounded-full bg-stone-200 flex items-center justify-center">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#9CA3AF" stroke-width="1.5">
              <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
          </div>
          <div class="text-center">
            <p class="font-semibold text-[var(--color-charcoal)] text-sm">Pieter</p>
            <p class="text-[var(--color-stone)] text-xs">Product & Engineering</p>
          </div>
        </div>

        <div>
          <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-4">Gebouwd door iemand die aan beide kanten van het rooster heeft gestaan.</h2>
          <p class="text-[var(--color-stone)] leading-relaxed text-lg mb-4">
            Ik ben Pieter. Van achtergrond ben ik data-engineer met een focus op AI en machine learning — ik heb productiepipelines gebouwd, modellen getraind en rommelige data omgezet in dingen die echt werken. Daarvoor (en tussendoor) was ik vloermanager bij een van de grootste horecalocaties in Utrecht.
          </p>
          <p class="text-[var(--color-stone)] leading-relaxed mb-4">
            Ik weet hoe een rooster van 16 man eruitziet op vrijdagmiddag om vier uur als twee mensen zich ziek melden. Ik weet ook hoe je software bouwt die niet instort onder druk. HorecaRooster is waar die twee dingen samenkomen.
          </p>
          <p class="text-[var(--color-stone)] leading-relaxed">
            Er is hier geen groeiteam dat optimaliseert voor upgrades. Alleen een product dat echt nuttig moet zijn voor mensen die kleine Nederlandse horecalocaties runnen — want ik ben zelf zo iemand geweest.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Waarden -->
  <section class="bg-[var(--color-cream)] py-20 px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-display font-bold text-2xl md:text-3xl text-[var(--color-charcoal)] text-center mb-10">Waar we in geloven</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {values.map((v) => (
          <div class="bg-white rounded-2xl p-7 border border-gray-100 shadow-sm">
            <div class="w-11 h-11 bg-[#E8F5EE] text-[var(--color-forest)] rounded-xl flex items-center justify-center mb-4" set:html={v.icon} />
            <h3 class="font-display font-semibold text-lg text-[var(--color-charcoal)] mb-2">{v.title}</h3>
            <p class="text-[var(--color-stone)] text-sm leading-relaxed">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Gemaakt in NL -->
  <section class="bg-white py-12 px-6 lg:px-8">
    <div class="max-w-2xl mx-auto text-center">
      <p class="text-[var(--color-stone)] flex items-center justify-center gap-2 text-lg">
        <span class="text-2xl">🇳🇱</span>
        Trots gemaakt in Nederland
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[var(--color-forest)] py-20 px-6 lg:px-8">
    <div class="max-w-2xl mx-auto text-center text-white">
      <h2 class="font-display font-bold text-3xl mb-4">Probeer het zelf.</h2>
      <p class="text-white/80 mb-8">Aan de slag voor €10/maand. Geen jaarcontract.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="https://app.rooster-maker.app" variant="secondary" size="lg">Aan de slag →</Button>
        <Button href="/contact" variant="ghost" size="lg">Neem contact op →</Button>
      </div>
    </div>
  </section>

</BaseLayout>
