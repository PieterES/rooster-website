---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";

const values = [
  {
    title: "Meer tijd voor je mensen",
    body: "Een rooster maken kost een manager uren per week. Dat is tijd die niet naar het personeel of de gasten gaat. HorecaRooster neemt die klus uit handen — zodat jij je aandacht kunt geven aan wat er écht toe doet op de werkvloer.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
  },
  {
    title: "Op menselijke schaal",
    body: "Gebouwd voor de kleine locaties waar de manager ook op de werkvloer staat. Elke ontwerpkeuze is gemaakt met een team van 12 in een café in gedachten, niet een hotelketen van 200 man.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>`,
  },
  {
    title: "Geen dure software, geen Excel-sheet",
    body: "Marges in de horeca zijn krap. Een dure planningtool past daar niet bij — maar een Excel-sheet is ook geen professionele oplossing. HorecaRooster is bewust eenvoudig en betaalbaar gehouden: de juiste tool, zonder dat het pijn doet aan de portemonnee.",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>`,
  },
];
---

<BaseLayout
  title="Over ons"
  description="HorecaRooster — gebouwd door iemand die het chaos zelf heeft meegemaakt. Data-engineer, AI-specialist en voormalig Floormanager in de Utrechtse horeca."
  lang="nl"
>

  <!-- Hero -->
  <section class="bg-[var(--color-forest)] pt-32 pb-20 px-6 lg:px-8 text-white">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="font-display font-bold text-4xl md:text-5xl leading-tight mb-4">
        Gebouwd door iemand die het van twee kanten kent.
      </h1>
    </div>
  </section>

  <!-- Missie -->
  <section class="bg-[var(--color-cream)] py-20 px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-xl text-[var(--color-charcoal)] leading-relaxed">
        HorecaRooster bestaat omdat kleine Nederlandse horecabedrijven planningstools verdienen die echt passen bij hoe ze werken.
      </p>
    </div>
  </section>

  <!-- Oprichtersectie -->
  <section class="bg-white py-20 px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <div>
        <div>
          <h2 class="font-display font-bold text-2xl text-[var(--color-charcoal)] mb-4">Gebouwd door iemand die aan beide kanten van het rooster heeft gestaan.</h2>
          <p class="text-[var(--color-stone)] leading-relaxed text-lg mb-4">
            Met een achtergrond in data-engineering met een focus op AI hebben wij professionele productiepipelines gebouwd en rommelige data omgezet in producten die echt werken. Daarnaast zijn wij Floormanager geweest bij een van de grootste horecalocaties in Utrecht.
          </p>
          <p class="text-[var(--color-stone)] leading-relaxed mb-4">
            Wij weten hoe een rooster van 40+ personeel, 3 afdelingen, meerdere locaties tegelijk eruitziet op een vrijdagavond om 19.00 uur als twee mensen zich ziek melden. We weten ook hoe je software bouwt die niet instort onder druk. Hier is waar die twee dingen samenkomen.
          </p>
          <p class="text-[var(--color-stone)] leading-relaxed">
            Met een passie voor horeca en frustratie voor inefficiënte planningstools hebben wij HorecaRooster opgericht. Alleen een product dat echt nuttig moet zijn voor mensen die kleine Nederlandse horecalocaties runnen — want die zijn wij zelf geweest.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Waarden -->
  <section class="bg-[var(--color-cream)] py-20 px-6 lg:px-8">
    <div class="max-w-5xl mx-auto">
      <h2 class="font-display font-bold text-2xl md:text-3xl text-[var(--color-charcoal)] text-center mb-10">Waar we in geloven</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {values.map((v) => (
          <div class="bg-white rounded-2xl p-7 border border-gray-100 shadow-sm">
            <div class="w-11 h-11 bg-[#E8F5EE] text-[var(--color-forest)] rounded-xl flex items-center justify-center mb-4" set:html={v.icon} />
            <h3 class="font-display font-semibold text-lg text-[var(--color-charcoal)] mb-2">{v.title}</h3>
            <p class="text-[var(--color-stone)] text-sm leading-relaxed">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[var(--color-forest)] py-20 px-6 lg:px-8">
    <div class="max-w-2xl mx-auto text-center text-white">
      <h2 class="font-display font-bold text-3xl mb-4">Probeer het zelf.</h2>
      <p class="text-white/80 mb-8">Aan de slag voor €10/maand. Geen jaarcontract.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="https://app.rooster-maker.app" variant="secondary" size="lg">Aan de slag →</Button>
        <Button href="/contact" variant="ghost" size="lg">Neem contact op →</Button>
      </div>
    </div>
  </section>

</BaseLayout>
