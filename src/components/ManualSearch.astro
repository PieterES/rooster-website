---
// Search box for the manual. Full-text search through Pagefind (index built after `astro build`,
// see package.json); falls back to matching titles and descriptions when the index isn't there
// (e.g. under `astro dev`). Results jump to the matching section when Pagefind finds one.
import { manualCategory, manualFor, manualHref, type ManualLang } from "../data/manual";

interface Props {
  lang: ManualLang;
  /** "hero" = large box on the hub, "compact" = sidebar on article pages. */
  size?: "hero" | "compact";
  /** Read ?q= from the URL and run that search on load (hub only). */
  readQuery?: boolean;
}

const { lang, size = "compact", readQuery = false } = Astro.props;
const t = (nl: string, en: string) => (lang === "nl" ? nl : en);

const fallbackIndex = manualFor(lang).map((a) => ({
  url: manualHref(a),
  title: a.title,
  description: a.description,
  category: manualCategory(a.category).label[lang],
}));

const hero = size === "hero";
---

<div
  class="manual-search relative"
  data-manual-search
  data-read-query={readQuery ? "" : undefined}
  data-none={t("Niets gevonden voor", "Nothing found for")}
  data-hint={t("Probeer een ander woord, of vraag het ons via Ondersteuning in de app.", "Try another word, or ask us through Support in the app.")}
>
  <label class="sr-only" for={`manual-search-${size}`}>{t("Zoek in de handleiding", "Search the manual")}</label>
  <div class="relative">
    <svg class:list={["absolute top-1/2 -translate-y-1/2 text-[var(--color-stone)] pointer-events-none", hero ? "left-5 w-5 h-5" : "left-3.5 w-4 h-4"]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="20" y1="20" x2="16.5" y2="16.5"/></svg>
    <input
      id={`manual-search-${size}`}
      type="search"
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="false"
      aria-controls={`manual-results-${size}`}
      aria-autocomplete="list"
      placeholder={hero ? t("Waar heb je hulp bij? Bijv. ruil goedkeuren", "What do you need help with? E.g. approve a swap") : t("Zoek in de handleiding…", "Search the manual…")}
      class:list={[
        "w-full rounded-xl border bg-white text-[var(--color-charcoal)] placeholder:text-[var(--color-stone)]/80 focus:outline-none focus:ring-2 focus:ring-[var(--color-amber)] transition-shadow",
        hero ? "border-transparent shadow-lg pl-13 pr-5 py-4 text-base md:text-lg" : "border-gray-200 pl-10 pr-3 py-2.5 text-sm",
      ]}
    />
  </div>
  <div
    id={`manual-results-${size}`}
    data-results
    role="listbox"
    hidden
    class:list={[
      "absolute left-0 right-0 z-30 mt-2 bg-white rounded-xl border border-gray-100 shadow-xl overflow-y-auto text-left",
      hero ? "max-h-[60vh]" : "max-h-[70vh]",
    ]}
  ></div>
  <script is:inline type="application/json" data-fallback set:html={JSON.stringify(fallbackIndex)} />
</div>

<script>
  type Hit = { url: string; title: string; excerpt: string; category?: string; section?: string };
  type Fallback = { url: string; title: string; description: string; category: string };
  interface PagefindResult {
    data: () => Promise<{
      url: string;
      excerpt: string;
      meta: Record<string, string>;
      sub_results?: { title: string; url: string; excerpt: string; weighted_locations?: { balanced_score: number }[] }[];
    }>;
  }
  interface Pagefind {
    options: (o: object) => Promise<void>;
    debouncedSearch: (q: string, o?: object, ms?: number) => Promise<{ results: PagefindResult[] } | null>;
  }

  let pagefind: Promise<Pagefind | null> | undefined;
  // Loaded lazily on first use; missing under `astro dev`, then we fall back to titles.
  function loadPagefind() {
    pagefind ??= (async () => {
      try {
        const url = "/pagefind/pagefind.js";
        const pf = (await import(/* @vite-ignore */ url)) as Pagefind;
        await pf.options({ excerptLength: 18 });
        return pf;
      } catch {
        return null;
      }
    })();
    return pagefind;
  }

  const escapeHtml = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const fold = (s: string) => s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");

  function fallbackSearch(index: Fallback[], q: string): Hit[] {
    const words = fold(q).split(/\s+/).filter(Boolean);
    const scored: { score: number; hit: Hit }[] = [];
    for (const a of index) {
      const title = fold(a.title);
      const all = `${title} ${fold(a.description)} ${fold(a.category)}`;
      if (!words.every((w) => all.includes(w))) continue;
      const score = words.filter((w) => title.includes(w)).length;
      scored.push({ score, hit: { url: a.url, title: a.title, excerpt: escapeHtml(a.description), category: a.category } });
    }
    return scored.sort((a, b) => b.score - a.score).map((x) => x.hit);
  }

  async function pagefindSearch(pf: Pagefind, q: string): Promise<Hit[] | null> {
    const search = await pf.debouncedSearch(q, {}, 150);
    if (!search) return null; // superseded by a newer keystroke
    const data = await Promise.all(search.results.slice(0, 8).map((r) => r.data()));
    return data.map((d) => {
      // Jump to the best-scoring section; when the title itself matches best, open the page top.
      const score = (s: { weighted_locations?: { balanced_score: number }[] }) =>
        (s.weighted_locations ?? []).reduce((sum, l) => sum + l.balanced_score, 0);
      const best = (d.sub_results ?? []).reduce<(typeof d.sub_results & {})[number] | undefined>(
        (top, s) => (!top || score(s) > score(top) ? s : top),
        undefined,
      );
      const section = best?.url.includes("#") ? best : undefined;
      return {
        url: section?.url ?? d.url,
        title: d.meta.title,
        excerpt: section?.excerpt ?? d.excerpt,
        category: d.meta.category,
        section: section?.title,
      };
    });
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-manual-search]")) {
    const input = root.querySelector("input")!;
    const panel = root.querySelector<HTMLElement>("[data-results]")!;
    const fallback = JSON.parse(root.querySelector("[data-fallback]")!.textContent!) as Fallback[];
    const i18n = { none: root.dataset.none!, hint: root.dataset.hint! };
    let active = -1;
    let seq = 0;

    const links = () => [...panel.querySelectorAll<HTMLAnchorElement>("a")];
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      input.setAttribute("aria-expanded", String(open));
    };
    const highlight = (i: number) => {
      const all = links();
      active = Math.max(-1, Math.min(i, all.length - 1));
      all.forEach((a, n) => a.setAttribute("aria-selected", String(n === active)));
      all[active]?.scrollIntoView({ block: "nearest" });
    };

    function render(q: string, hits: Hit[]) {
      active = -1;
      if (!hits.length) {
        panel.innerHTML = `<div class="px-5 py-4 text-sm text-[var(--color-stone)]"><p class="font-medium text-[var(--color-charcoal)]">${i18n.none} "${escapeHtml(q)}"</p><p class="mt-1">${i18n.hint}</p></div>`;
      } else {
        panel.innerHTML = hits
          .map(
            (h) => `<a role="option" href="${h.url}" class="manual-hit block px-5 py-3.5 border-b border-gray-50 last:border-0">
              <span class="flex items-baseline justify-between gap-3">
                <span class="font-semibold text-[var(--color-charcoal)]">${escapeHtml(h.title)}</span>
                ${h.category ? `<span class="shrink-0 text-[11px] font-semibold uppercase tracking-wider text-[var(--color-forest)]">${escapeHtml(h.category)}</span>` : ""}
              </span>
              ${h.section ? `<span class="block text-xs font-medium text-[var(--color-amber)] mt-0.5">→ ${escapeHtml(h.section)}</span>` : ""}
              <span class="block text-sm text-[var(--color-stone)] mt-1 leading-snug">${h.excerpt}</span>
            </a>`,
          )
          .join("");
      }
      setOpen(true);
    }

    async function run() {
      const q = input.value.trim();
      const mine = ++seq;
      if (q.length < 2) return setOpen(false);
      const pf = await loadPagefind();
      const hits = pf ? await pagefindSearch(pf, q) : fallbackSearch(fallback, q);
      if (hits && mine === seq) render(q, hits);
    }

    input.addEventListener("input", run);
    input.addEventListener("focus", () => {
      loadPagefind();
      if (input.value.trim().length >= 2) run();
    });
    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") { e.preventDefault(); highlight(active + 1); }
      else if (e.key === "ArrowUp") { e.preventDefault(); highlight(active - 1); }
      else if (e.key === "Enter") {
        const target = links()[active] ?? links()[0];
        if (target) { e.preventDefault(); target.click(); }
      } else if (e.key === "Escape") {
        if (!panel.hidden) setOpen(false);
        else input.value = "";
      }
    });
    document.addEventListener("click", (e) => {
      if (!root.contains(e.target as Node)) setOpen(false);
    });

    if (root.hasAttribute("data-read-query")) {
      const q = new URLSearchParams(location.search).get("q");
      if (q) {
        input.value = q;
        run();
      }
    }
  }

  // "/" focuses the first search box on the page, like most docs sites.
  document.addEventListener("keydown", (e) => {
    const el = document.activeElement;
    if (e.key !== "/" || e.metaKey || e.ctrlKey || (el && /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName))) return;
    const input = document.querySelector<HTMLInputElement>("[data-manual-search] input");
    if (input) { e.preventDefault(); input.focus(); }
  });
</script>

<style>
  .manual-search :global(.manual-hit:hover),
  .manual-search :global(.manual-hit[aria-selected="true"]) {
    background: var(--color-cream);
  }
  .manual-search :global(mark) {
    background: color-mix(in srgb, var(--color-amber) 25%, white);
    color: inherit;
    border-radius: 2px;
    padding: 0 1px;
  }
  .pl-13 { padding-left: 3.25rem; }
</style>
