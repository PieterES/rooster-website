---
// The admin dashboard of the app (Vandaag), rebuilt with demo data in the app's own look (the "P"
// design with the sage/gold "soul" layer of HorecaRooster: Newsreader, Libre Franklin, Courier Prime).
// The script puts the now line on the visitor's current Dutch time and works out each shift's status
// from it, so the board looks live at any moment of the day.
import "@fontsource-variable/newsreader/wght.css";
import "@fontsource-variable/newsreader/wght-italic.css";
import "@fontsource-variable/libre-franklin/wght.css";
import "@fontsource/courier-prime/latin-400.css";
import "@fontsource/courier-prime/latin-700.css";

interface Props {
  lang: "nl" | "en";
}
const { lang } = Astro.props;

const t = {
  nl: {
    nav: ["Vandaag", "Rooster", "Verzoeken", "Medewerkers", "Uren", "Communicatie"],
    locations: "Alle locaties",
    working: "Nu aan het werk",
    coming: "Komt nog",
    openToday: "Open vandaag",
    waiting: "Wacht op jou",
    all: "Alle 6",
    claims: "Claims op open diensten",
    claimsSub: "wachten op je goedkeuring",
    swaps: "Ruilverzoeken",
    swapsSub: "collega's zijn het eens, jij beslist",
    leave: "Vakantieverzoeken",
    corrections: "Urencorrecties",
    openWeek: "Open deze week",
    toSchedule: "Naar rooster",
    openRows: [["VR", "Keuken, Prep", "08:00–14:00"], ["ZA", "Bediening, Lunch", "11:00–15:30"]],
    url: "app.gedekt.com/admin",
    caption: "Voorbeeld met demodata, de tijdlijn loopt live mee met de klok",
  },
  en: {
    nav: ["Today", "Schedule", "Requests", "Staff", "Hours", "Communication"],
    locations: "All locations",
    working: "Working now",
    coming: "Still to come",
    openToday: "Open today",
    waiting: "Waiting for you",
    all: "All 6",
    claims: "Claims on open shifts",
    claimsSub: "waiting for your approval",
    swaps: "Swap requests",
    swapsSub: "colleagues agreed, you decide",
    leave: "Leave requests",
    corrections: "Hours corrections",
    openWeek: "Open this week",
    toSchedule: "To schedule",
    openRows: [["FRI", "Kitchen, Prep", "08:00–14:00"], ["SAT", "Floor, Lunch", "11:00–15:30"]],
    url: "app.gedekt.com/admin",
    caption: "Example with demo data, the timeline runs live with the clock",
  },
}[lang];
const nl = lang === "nl";

// in/out: minutes after the shift's start / end at which the person clocks in / out (shown rounded,
// see the script). Roos and Jesse clock in late: first "niet ingeklokt", then a "te laat" tag.
const depts = [
  {
    name: "Bar",
    color: "#8c2f39",
    rows: [
      { who: "Sanne de Graaf", shift: nl ? "Middag" : "Afternoon", rank: "Bartender", start: "12:00", end: "18:00", in: -4, out: 7 },
      { who: "Jesse Bos", shift: nl ? "Avond" : "Evening", rank: nl ? "Barchef" : "Bar manager", start: "17:00", end: "23:30", in: 22, out: 4 },
      { who: "Milan Peters", shift: nl ? "Sluit" : "Close", rank: "Bartender", start: "21:30", end: "01:00", in: -5, out: 3 },
    ],
  },
  {
    name: nl ? "Bediening" : "Floor",
    color: "#1f5a4a",
    rows: [
      { who: "Roos Vermeer", shift: "Lunch", rank: nl ? "Ober" : "Waiter", start: "11:00", end: "15:30", in: 41, out: 2 },
      { who: "Lars van den Berg", shift: nl ? "Middag" : "Afternoon", rank: nl ? "Ober" : "Waiter", start: "14:30", end: "20:00", in: -1, out: 4 },
      { who: "Vera Hoekstra", shift: nl ? "Diner" : "Dinner", rank: nl ? "Ober" : "Waiter", start: "17:00", end: "23:00", in: -6, out: 12 },
      { who: "Sophie Janssen", shift: nl ? "Sluit" : "Close", rank: nl ? "Hoofdober" : "Head waiter", start: "21:00", end: "00:30", in: -3, out: 5 },
    ],
  },
  {
    name: nl ? "Keuken" : "Kitchen",
    color: "#35485c",
    rows: [
      { who: "Joost Hendriks", shift: "Prep", rank: nl ? "Kok" : "Cook", start: "08:00", end: "14:00", in: -2, out: 6 },
      { who: "Daan Smits", shift: "Lunch", rank: "Sous-chef", start: "10:30", end: "16:00", in: -3, out: 3 },
      { who: "Emma de Wit", shift: nl ? "Diner" : "Dinner", rank: nl ? "Chef de cuisine" : "Head chef", start: "15:00", end: "23:00", in: -4, out: 9 },
    ],
  },
];

// Axis 08:00 → 01:00 in hours, as the app draws it for this day (dayAxis in the app).
const FROM = 8 * 60;
const TO = 25 * 60;
const toMin = (hhmm: string) => {
  const [h, m] = hhmm.split(":").map(Number);
  return h * 60 + m;
};
const span = (start: string, end: string): [number, number] => {
  const s = toMin(start);
  let e = toMin(end);
  if (e <= s) e += 1440;
  return [s, e];
};
const pct = (m: number) => ((m - FROM) / (TO - FROM)) * 100;
const hours = Array.from({ length: (TO - FROM) / 60 }, (_, i) => FROM + i * 60);
const hh = (m: number) => String(Math.floor(m / 60) % 24).padStart(2, "0");
---

<figure class="live-dash" data-live-dash data-lang={lang} aria-label={t.caption}>
  <div class="ld-window">
    <div class="ld-chrome" aria-hidden="true">
      <span class="ld-dots"><i></i><i></i><i></i></span>
      <span class="ld-url">{t.url}</span>
    </div>

    <div class="ld-app">
      <div class="ld-bar-top" aria-hidden="true">
        <span class="ld-logo">Gedekt</span>
        <span class="ld-company">De Gouden Lepel</span>
        <span class="ld-nav">
          {t.nav.map((n, i) => (
            <span class={i === 0 ? "is-active" : ""}>
              {n}{i === 2 && <em>6</em>}{(i === 1 || i >= 3) && <svg viewBox="0 0 10 6" width="9" height="6"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>}
            </span>
          ))}
        </span>
        <span class="ld-tools">
          <span class="ld-select">{t.locations}<svg viewBox="0 0 10 6" width="9" height="6"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></span>
          <svg viewBox="0 0 20 20" width="16" height="16"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M13 13l4 4" stroke="currentColor" stroke-width="1.6" /></svg>
          <svg viewBox="0 0 20 20" width="16" height="16"><path d="M5 14V9a5 5 0 0110 0v5l1.5 1.5h-13zM8.5 17.5h3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>
        </span>
      </div>

      <div class="ld-page">
        <section class="ld-sheet ld-today">
          <div class="ld-head">
            <h3 class="ld-title"><i class="ld-gold" aria-hidden="true"></i><span data-date>&nbsp;</span> <span class="ld-num ld-clock" data-clock></span></h3>
            <dl class="ld-stats">
              <div><dt>{t.working}</dt><dd class="ld-num" data-stat="working"></dd></div>
              <div><dt>{t.coming}</dt><dd class="ld-num" data-stat="coming"></dd></div>
              <div><dt>{t.openToday}</dt><dd class="ld-num">0</dd></div>
            </dl>
          </div>

          <div class="ld-timeline">
            <div class="ld-axis" aria-hidden="true">
              <span class="ld-label-col"></span>
              <div class="ld-axis-track">
                {hours.map((m) => <span class="ld-num" data-hour={m} style={`left:${pct(m)}%`}>{hh(m)}</span>)}
                <b class="ld-num ld-now-tag" data-now-tag></b>
              </div>
            </div>

            <div class="ld-lanes">
              <b class="ld-now" data-now-line aria-hidden="true"></b>
              {depts.map((d) => (
                <section class="ld-dept" style={`--dep:${d.color}`}>
                  <h4><i class="ld-diamond" aria-hidden="true"></i>{d.name}</h4>
                  {d.rows.map((r) => {
                    const [s, e] = span(r.start, r.end);
                    return (
                      <div class="ld-row" data-row data-start={s} data-end={e} data-in={r.in} data-out={r.out}>
                        <div class="ld-label-col ld-who">
                          <p class="ld-name">{r.who}</p>
                          <p class="ld-role">{r.shift}, {r.rank}</p>
                        </div>
                        <div class="ld-track">
                          <div class="ld-shiftbar" style={`left:${pct(s)}%;width:${pct(e) - pct(s)}%`}>
                            <span class="ld-num ld-times">{r.start}–{r.end}</span>
                            <span class="ld-status" data-status></span>
                            <span class="ld-late" data-late></span>
                          </div>
                        </div>
                        <span class="ld-phone-status" data-phone-status></span>
                      </div>
                    );
                  })}
                </section>
              ))}
            </div>
          </div>
        </section>

        <aside class="ld-side">
          <section class="ld-sheet">
            <div class="ld-side-head"><h3><i class="ld-gold" aria-hidden="true"></i>{t.waiting}</h3><span>{t.all}</span></div>
            <ul class="ld-list">
              <li><span><b>{t.claims}</b><small>{t.claimsSub}</small></span><em class="ld-num">2</em></li>
              <li><span><b>{t.swaps}</b><small>{t.swapsSub}</small></span><em class="ld-num">2</em></li>
              <li><span><b>{t.leave}</b></span><em class="ld-num">1</em></li>
              <li><span><b>{t.corrections}</b></span><em class="ld-num">1</em></li>
            </ul>
          </section>
          <section class="ld-sheet">
            <div class="ld-side-head"><h3><i class="ld-gold" aria-hidden="true"></i>{t.openWeek}</h3><span>{t.toSchedule}</span></div>
            <ul class="ld-list ld-open">
              {t.openRows.map(([day, what, time], i) => (
                <li><span class="ld-day">{day} <span data-open-date={i + 3}></span></span><b>{what}</b><span class="ld-num">{time}</span></li>
              ))}
            </ul>
          </section>
        </aside>
      </div>
    </div>
  </div>
  <figcaption class="ld-caption"><span class="ld-pulse"></span>{t.caption}</figcaption>
</figure>

<script>
  const TZ = "Europe/Amsterdam";
  const FROM = 8 * 60;
  const TO = 25 * 60;
  const LATE_AFTER = 15; // minutes, LATE_AFTER_MIN in the app
  // The app rounds clock-ins up and clock-outs down to the quarter hour.
  const roundIn = (m: number) => Math.ceil(m / 15) * 15;
  const roundOut = (m: number) => Math.floor(m / 15) * 15;
  const NIGHT_SNAPSHOT = 19 * 60 + 45; // between 01:00 and 08:00 the board shows the evening

  const words = {
    nl: {
      active: "sinds {t}",
      late: "niet ingeklokt, {n} min",
      lateTag: "{n} min te laat",
      upcoming: "komt om {t}",
      done: "klaar, uit {t}",
      now: "nu",
      locale: "nl-NL",
    },
    en: {
      active: "since {t}",
      late: "not clocked in, {n} min",
      lateTag: "{n} min late",
      upcoming: "comes at {t}",
      done: "done, out {t}",
      now: "now",
      locale: "en-GB",
    },
  };

  const hhmm = (m: number) => `${String(Math.floor(m / 60) % 24).padStart(2, "0")}:${String(Math.round(m) % 60).padStart(2, "0")}`;
  const pct = (m: number) => ((m - FROM) / (TO - FROM)) * 100;

  function amsterdamNow() {
    const parts = new Intl.DateTimeFormat("en-GB", { timeZone: TZ, hour: "2-digit", minute: "2-digit", hourCycle: "h23" }).formatToParts(new Date());
    const h = +parts.find((p) => p.type === "hour")!.value;
    const m = +parts.find((p) => p.type === "minute")!.value;
    let min = h * 60 + m;
    if (min < 1 * 60) min += 1440; // after midnight: still the same service day
    if (min < FROM) min = NIGHT_SNAPSHOT;
    return min;
  }

  function render(root: HTMLElement) {
    const w = words[(root.dataset.lang as "nl" | "en") ?? "nl"];
    const now = amsterdamNow();
    let working = 0, coming = 0;

    root.querySelectorAll<HTMLElement>("[data-row]").forEach((row) => {
      const s = +row.dataset.start!, e = +row.dataset.end!;
      const clockIn = s + +row.dataset.in!, clockOut = e + +row.dataset.out!;
      let kind: string, text: string, late = "";
      if (now >= clockOut) { kind = "done"; text = w.done.replace("{t}", hhmm(roundOut(clockOut))); }
      else if (now >= clockIn) {
        kind = "active"; working++;
        const since = roundIn(clockIn);
        text = w.active.replace("{t}", hhmm(since));
        if (since - s > LATE_AFTER) late = w.lateTag.replace("{n}", String(since - s));
      }
      else if (now >= s + LATE_AFTER) { kind = "late"; coming++; text = w.late.replace("{n}", String(now - s)); }
      else { kind = "upcoming"; coming++; text = w.upcoming.replace("{t}", hhmm(s)); }
      row.dataset.kind = kind;
      row.querySelector("[data-status]")!.textContent = text;
      row.querySelector("[data-late]")!.textContent = late;
      row.querySelector("[data-phone-status]")!.textContent = text;
    });

    root.querySelector("[data-stat=working]")!.textContent = String(working);
    root.querySelector("[data-stat=coming]")!.textContent = String(coming);

    const time = hhmm(now);
    root.querySelector("[data-clock]")!.textContent = time;
    const tag = root.querySelector<HTMLElement>("[data-now-tag]")!;
    tag.textContent = `${w.now} ${time}`;
    tag.style.left = `${pct(now)}%`;
    root.querySelector<HTMLElement>("[data-now-line]")!.style.setProperty("--p", String(pct(now) / 100));
    root.querySelectorAll<HTMLElement>("[data-hour]").forEach((h) => {
      h.style.visibility = Math.abs(+h.dataset.hour! - now) < 40 ? "hidden" : "";
    });

    const today = new Date();
    const date = new Intl.DateTimeFormat(w.locale, { timeZone: TZ, weekday: "long", day: "numeric", month: "long" }).format(today);
    root.querySelector("[data-date]")!.textContent = date.charAt(0).toUpperCase() + date.slice(1);
    // "Open deze week": a couple of days ahead
    root.querySelectorAll<HTMLElement>("[data-open-date]").forEach((el) => {
      const d = new Date(today.getTime() + +el.dataset.openDate! * 86_400_000);
      el.textContent = new Intl.DateTimeFormat(w.locale, { timeZone: TZ, day: "numeric" }).format(d);
      const day = new Intl.DateTimeFormat(w.locale, { timeZone: TZ, weekday: "short" }).format(d).replace(".", "").toUpperCase();
      el.parentElement!.firstChild!.textContent = `${day} `;
    });
  }

  document.querySelectorAll<HTMLElement>("[data-live-dash]").forEach((root) => {
    render(root);
    setInterval(() => render(root), 30_000);
  });
</script>

<style>
  .live-dash {
    min-width: 0;
    /* the app's light palette (globals.css + soul.css in HorecaRooster) */
    --shelf: #35523f;
    --onshelf: #f1f3e6;
    --onshelf2: #bfcdbe;
    --brassline: #c9a227;
    --paper: #fcf9f0;
    --sheet: #fff;
    --ink: #1a1a1a;
    --ink2: #526055;
    --rule: #d8dcc8;
    --rule2: #9da58a;
    --red: #b3261e;
    --redbg: #fbedea;
    --fit: #35523f;
    --shadow: 4px 5px 0 rgba(27, 36, 48, 0.12);
    --lw: 150px; /* label column */
    --f-head: "Newsreader Variable", Georgia, serif;
    --f-ui: "Libre Franklin Variable", system-ui, sans-serif;
    --f-num: "Courier Prime", ui-monospace, monospace;
    margin: 0;
    text-align: left;
    color: var(--ink);
    font-family: var(--f-ui);
    font-size: 14px;
    line-height: 1.35;
  }
  .live-dash p, .live-dash h3, .live-dash h4, .live-dash dl, .live-dash dd, .live-dash ul { margin: 0; }
  .ld-num { font-family: var(--f-num); font-variant-numeric: tabular-nums; }

  .ld-window {
    border-radius: 10px;
    overflow: hidden;
    background: var(--paper);
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.55), 0 0 0 1px rgb(255 255 255 / 0.12);
  }
  .ld-chrome { display: flex; align-items: center; gap: 12px; height: 32px; padding: 0 14px; background: #e9e6dc; border-bottom: 1px solid var(--rule); }
  .ld-dots { display: flex; gap: 6px; }
  .ld-dots i { width: 10px; height: 10px; border-radius: 50%; background: #cfcabb; }
  .ld-url {
    flex: 1; min-width: 0; max-width: 320px; margin: 0 auto; padding: 2px 12px; border-radius: 6px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    background: #f7f5ee; color: var(--ink2); font-size: 12px; text-align: center;
  }

  /* top bar: dark sage shelf with the gold line */
  .ld-bar-top {
    display: flex; align-items: center; gap: 14px; height: 48px; padding: 0 18px;
    background: var(--shelf); color: var(--onshelf); box-shadow: inset 0 -3px 0 var(--brassline);
    white-space: nowrap; overflow: hidden;
  }
  .ld-logo { font: italic 500 23px/1 var(--f-head); }
  .ld-company { padding-left: 10px; border-left: 1px solid #5d7a66; color: var(--onshelf2); font-size: 10.5px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
  .ld-nav { display: flex; gap: 16px; margin-left: 8px; min-width: 0; overflow: hidden; font-size: 14px; }
  .ld-nav span { display: inline-flex; align-items: center; gap: 5px; }
  .ld-nav svg { opacity: 0.7; }
  .ld-nav .is-active { color: var(--brassline); box-shadow: inset 0 -2px 0 var(--brassline); padding-bottom: 3px; margin-bottom: -5px; }
  .ld-nav em { font: 700 11px/1 var(--f-num); font-style: normal; padding: 2px 4px; border: 1px solid var(--onshelf2); background: #8c2f39; }
  .ld-tools { display: flex; align-items: center; gap: 18px; margin-left: auto; color: var(--onshelf); }
  .ld-select { display: inline-flex; align-items: center; gap: 18px; padding: 4px 8px; border: 1.5px solid var(--onshelf2); font-size: 12.5px; font-weight: 600; }

  .ld-page { display: grid; grid-template-columns: minmax(0, 1fr) 270px; gap: 16px; align-items: start; padding: 18px; }
  .ld-sheet { background: var(--sheet); border: 1px solid var(--rule); box-shadow: var(--shadow); padding: 16px 20px 18px; }
  .ld-gold { display: inline-block; flex: none; width: 7px; height: 7px; margin-right: 10px; background: var(--brassline); transform: rotate(45deg); position: relative; top: -0.12em; }

  /* header: date, time, three numbers */
  .ld-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 10px 16px; padding-bottom: 12px; border-bottom: 2px solid var(--fit); }
  .ld-title { font: 600 28px/1.1 var(--f-head); letter-spacing: -0.01em; white-space: nowrap; }
  .ld-clock { margin-left: 10px; font-size: 15px; font-weight: 700; letter-spacing: 0.04em; }
  .ld-stats { display: flex; gap: 14px; }
  .ld-stats div { min-width: 84px; border-bottom: 1px solid var(--rule2); padding-bottom: 3px; }
  .ld-stats dt { font-size: 10.5px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap; }
  .ld-stats dd { font-size: 12px; }

  /* timeline */
  .ld-axis, .ld-row { display: grid; grid-template-columns: var(--lw) minmax(0, 1fr); }
  .ld-axis { border-bottom: 2px solid var(--ink); }
  .ld-axis > .ld-label-col { border-right: 2px solid var(--ink); }
  .ld-axis-track { position: relative; height: 34px; }
  .ld-axis-track span { position: absolute; bottom: 4px; padding-left: 4px; font-size: 11px; color: var(--ink2); }
  .ld-now-tag {
    position: absolute; bottom: 4px; transform: translateX(-50%); padding: 0 6px; background: var(--fit); color: var(--sheet);
    font-size: 11.5px; font-weight: 700; line-height: 19px; white-space: nowrap; transition: left 0.6s ease;
  }
  .ld-lanes { position: relative; }
  .ld-now {
    position: absolute; top: 0; bottom: 0; z-index: 2; width: 2px; background: var(--fit); pointer-events: none;
    left: calc(var(--lw) + (100% - var(--lw)) * var(--p, 0) - 1px); transition: left 0.6s ease;
  }
  .ld-dept h4 {
    display: flex; align-items: center; gap: 10px; padding: 16px 0 5px; border-bottom: 2px solid var(--dep);
    color: var(--dep); font: 600 20px/1.3 var(--f-head);
  }
  .ld-diamond { width: 10px; height: 10px; margin: 3px; background: var(--dep); transform: rotate(45deg); }
  .ld-row { height: 44px; border-bottom: 1px solid var(--rule); }
  .ld-who { min-width: 0; padding: 5px 8px 0 0; border-right: 2px solid var(--dep); }
  .ld-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--dep); font-size: 12.5px; font-weight: 600; line-height: 1.25; }
  .ld-role { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink2); font-size: 11.5px; line-height: 1.25; }
  .ld-track { position: relative; background-image: linear-gradient(to right, var(--rule) 1px, transparent 1px); background-size: calc(100% / 17) 100%; }
  .ld-shiftbar {
    position: absolute; top: 8px; height: 27px; display: flex; align-items: center; gap: 7px; padding: 0 7px;
    overflow: hidden; white-space: nowrap; font-size: 12px; box-sizing: border-box;
    transition: background-color 0.4s, color 0.4s;
  }
  .ld-times { flex: none; font-size: 10.5px; font-weight: 700; }
  .ld-status { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .ld-late:empty { display: none; }
  /* a late clock-in: "sinds 17:30" + the tag matter more than the times, which don't fit next to them */
  .ld-shiftbar:has(.ld-late:not(:empty)) .ld-times { display: none; }
  .ld-late { flex: none; padding: 0 4px; background: var(--sheet); color: var(--red); font-size: 11px; font-weight: 700; }
  .ld-phone-status { display: none; }

  /* the bar per status, as the app's today-timeline draws it */
  .ld-row[data-kind="active"] .ld-shiftbar { background: var(--dep); color: var(--sheet); }
  .ld-row[data-kind="upcoming"] .ld-shiftbar { background: var(--sheet); color: var(--dep); border: 1.5px solid var(--dep); }
