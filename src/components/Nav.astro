---
import { demos, demoHref } from "../data/demos";
import { isEnglishPath, normalisePath, translatedPath } from "../data/routes";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const isNL = !isEnglishPath(currentPath);

// NL <-> EN page pairs live in src/data/routes.ts
const normalised = normalisePath(currentPath);
const alternatePath = translatedPath(normalised) ?? (isNL ? "/en/" : "/");

const links = isNL
  ? [
      { href: "/product-tour",  label: "Product" },
      { href: "/hoe-het-werkt", label: "Hoe het werkt" },
      { href: "/prijzen",       label: "Prijzen" },
      { href: "/gidsen",        label: "Gidsen" },
      { href: "/contact",       label: "Contact" },
      { href: "/over-ons",      label: "Over ons" },
    ]
  : [
      { href: "/en/product-tour",  label: "Product" },
      { href: "/en/how-it-works",  label: "How It Works" },
      { href: "/en/pricing",       label: "Pricing" },
      { href: "/en/guides",        label: "Guides" },
      { href: "/en/contact",       label: "Contact" },
      { href: "/en/about",         label: "About" },
    ];

// Demo pages shown in the dropdown under the "how it works" link
const featuresHref = isNL ? "/hoe-het-werkt" : "/en/how-it-works";
const demoLinks = demos.map((d) => ({ href: demoHref(d, isNL ? "nl" : "en"), label: d.menuLabel[isNL ? "nl" : "en"] }));
const allFeaturesLabel = isNL ? "Alles over hoe het werkt" : "Everything about how it works";
const seeItLabel = isNL ? "Zie hoe het werkt" : "See how it works";
const linkClass = (href: string) => [
  "text-sm font-medium whitespace-nowrap transition-colors duration-200 hover:text-[var(--color-amber)]",
  normalised === href || normalised.startsWith(href + "/")
    ? "text-[var(--color-forest)] font-semibold"
    : "text-[var(--color-charcoal)]",
];

const ctaLabel = isNL ? "Aan de slag →" : "Get started →";
const loginLabel = isNL ? "Inloggen" : "Log in";
---

<header
  id="site-nav"
  class="fixed top-0 left-0 right-0 z-50 bg-[#FAFAF7] border-b border-gray-100 shadow-sm"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-8 flex items-center justify-between h-16">
    <!-- Logo -->
    <a href={isNL ? "/" : "/en/"} class="flex items-center gap-2 font-display font-700 text-xl" aria-label="Gedekt home">
      <img src="/favicon.png" alt="Gedekt logo" width="28" height="28" />
      <span class="text-[var(--color-charcoal)]">Gedekt</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden lg:flex items-center gap-6 xl:gap-8" aria-label="Main navigation">
      {links.map((l) => l.href === featuresHref ? (
        <div class="relative group">
          <a href={l.href} class:list={[...linkClass(l.href), "inline-flex items-center gap-1"]} aria-haspopup="true">
            {l.label}
            <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180 group-focus-within:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </a>
          <div class="absolute left-1/2 -translate-x-1/2 top-full pt-3 invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 transition-all duration-150">
            <div class="w-64 bg-white rounded-xl border border-gray-100 shadow-xl p-2">
              <p class="px-3 pt-2 pb-1 text-[11px] font-semibold uppercase tracking-widest text-[var(--color-amber)]">{seeItLabel}</p>
              {demoLinks.map((d) => (
                <a
                  href={d.href}
                  class:list={[
                    "flex items-center gap-2 px-3 py-2 rounded-lg text-sm transition-colors hover:bg-[var(--color-cream)]",
                    normalised === d.href ? "text-[var(--color-forest)] font-semibold" : "text-[var(--color-charcoal)]",
                  ]}
                >
                  <svg class="w-3.5 h-3.5 text-[var(--color-forest)] shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="6 4 20 12 6 20 6 4"/></svg>
                  {d.label}
                </a>
              ))}
              <a href={l.href} class="block mt-1 px-3 py-2 rounded-lg text-sm font-medium text-[var(--color-stone)] border-t border-gray-100 hover:text-[var(--color-forest)] transition-colors">
                {allFeaturesLabel} →
              </a>
            </div>
          </div>
        </div>
      ) : (
        <a href={l.href} class:list={linkClass(l.href)}>{l.label}</a>
      ))}
    </nav>

    <!-- Desktop CTA + Language switcher -->
    <div class="hidden lg:flex items-center gap-3 xl:gap-4 whitespace-nowrap">
      <div class="flex items-center gap-1 text-xs font-medium">
        <a
          href={!isNL ? normalised : alternatePath}
          hreflang="en"
          aria-label="Switch to English"
          class:list={["px-2 py-1 rounded transition-colors hover:text-[var(--color-forest)]", !isNL ? "text-[var(--color-forest)] font-semibold" : "text-[var(--color-stone)]"]}
        >EN</a>
        <span class="text-gray-300">|</span>
        <a
          href={isNL ? normalised : alternatePath}
          hreflang="nl"
          aria-label="Schakel naar Nederlands"
          class:list={["px-2 py-1 rounded transition-colors hover:text-[var(--color-forest)]", isNL ? "text-[var(--color-forest)] font-semibold" : "text-[var(--color-stone)]"]}
        >NL</a>
      </div>
      <a
        href={isNL ? "/contact" : "/en/contact"}
        class="text-sm font-medium text-[var(--color-charcoal)] border border-[var(--color-forest)] px-5 py-2.5 rounded-lg hover:bg-[var(--color-forest)] hover:text-white transition-colors duration-200"
      >
        {ctaLabel}
      </a>
      <a
        href="https://app.gedekt.com/login"
        class="bg-[var(--color-forest)] text-white text-sm font-semibold px-5 py-2.5 rounded-lg hover:bg-[var(--color-forest-light)] transition-colors duration-200"
      >
        {loginLabel}
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="lg:hidden p-2 rounded-lg text-[var(--color-charcoal)]"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <svg id="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <svg id="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile drawer -->
<div
  id="mobile-drawer"
  class="fixed inset-0 z-40 bg-white transform translate-x-full transition-transform duration-300 lg:hidden flex flex-col pt-20 px-8 pb-8 overflow-y-auto"
  aria-hidden="true"
>
  <nav class="flex flex-col gap-6" aria-label="Mobile navigation">
    {links.map((l) => (
      <div>
        <a href={l.href} class="text-2xl font-display font-semibold text-[var(--color-charcoal)] hover:text-[var(--color-forest)]">
          {l.label}
        </a>
        {l.href === featuresHref && (
          <div class="flex flex-col gap-2.5 mt-3 pl-4 border-l-2 border-[#E8F5EE]">
            {demoLinks.map((d) => (
              <a href={d.href} class="text-base text-[var(--color-stone)] hover:text-[var(--color-forest)]">{d.label}</a>
            ))}
          </div>
        )}
      </div>
    ))}
    <div class="flex items-center gap-3 pt-2">
      <a
        href={!isNL ? normalised : alternatePath}
        hreflang="en"
        class:list={["text-sm font-medium transition-colors", !isNL ? "text-[var(--color-forest)] font-semibold" : "text-[var(--color-stone)] hover:text-[var(--color-forest)]"]}
      >EN</a>
      <span class="text-gray-300">|</span>
      <a
        href={isNL ? normalised : alternatePath}
        hreflang="nl"
        class:list={["text-sm font-medium transition-colors", isNL ? "text-[var(--color-forest)] font-semibold" : "text-[var(--color-stone)] hover:text-[var(--color-forest)]"]}
      >NL</a>
    </div>
  </nav>
  <div class="mt-auto flex flex-col gap-3">
    <a href={isNL ? "/contact" : "/en/contact"} class="text-center border border-[var(--color-forest)] text-[var(--color-forest)] font-semibold py-3 rounded-lg">
      {ctaLabel}
    </a>
    <a href="https://app.gedekt.com/login" class="text-center bg-[var(--color-forest)] text-white font-semibold py-3 rounded-lg">
      {loginLabel}
    </a>
  </div>
</div>

<script>
  const menuBtn = document.getElementById("mobile-menu-btn")!;
  const drawer = document.getElementById("mobile-drawer")!;
  const iconOpen = document.getElementById("icon-open")!;
  const iconClose = document.getElementById("icon-close")!;

  menuBtn.addEventListener("click", () => {
    const isOpen = drawer.getAttribute("aria-hidden") === "false";
    if (isOpen) {
      drawer.classList.add("translate-x-full");
      drawer.setAttribute("aria-hidden", "true");
      menuBtn.setAttribute("aria-expanded", "false");
      iconOpen.classList.remove("hidden");
      iconClose.classList.add("hidden");
    } else {
      drawer.classList.remove("translate-x-full");
      drawer.setAttribute("aria-hidden", "false");
      menuBtn.setAttribute("aria-expanded", "true");
      iconOpen.classList.add("hidden");
      iconClose.classList.remove("hidden");
    }
  });
</script>
