---
// Footer.astro
import { guides, guideHref } from "../data/guides";

interface Props {
  lang?: "nl" | "en";
}
const { lang = "en" } = Astro.props;

const t = lang === "nl" ? {
  tagline: "Personeelsplanning voor de Nederlandse horeca.",
  madeIn: "Gemaakt in Nederland",
  product: "Product",
  features: "Functies",
  pricing: "Prijzen",
  howItWorks: "Hoe het werkt",
  company: "Bedrijf",
  about: "Over ons",
  contact: "Contact",
  support: "Support",
  manual: "Handleiding",
  copyright: "© 2026 Gedekt. Alle rechten voorbehouden.",
  featuresHref: "/hoe-het-werkt#functies",
  pricingHref: "/prijzen",
  howItWorksHref: "/hoe-het-werkt",
  aboutHref: "/over-ons",
  contactHref: "/contact",
  manualHref: "/handleiding",
  guides: "Gidsen",
  allGuides: "Alle gidsen",
  guidesHref: "/gidsen",
  guideLabels: { schedule: "Rooster maken", "working-time-act": "Arbeidstijdenwet", "on-call": "Oproepkrachten", "labour-cost": "Loonkosten" },
} : {
  tagline: "Workforce scheduling for Dutch hospitality.",
  madeIn: "Made in the Netherlands",
  product: "Product",
  features: "Features",
  pricing: "Pricing",
  howItWorks: "How It Works",
  company: "Company",
  about: "About",
  contact: "Contact",
  support: "Support",
  manual: "User manual",
  copyright: "© 2026 Gedekt. All rights reserved.",
  featuresHref: "/en/how-it-works#features",
  pricingHref: "/en/pricing",
  howItWorksHref: "/en/how-it-works",
  aboutHref: "/en/about",
  contactHref: "/en/contact",
  manualHref: "/en/manual",
  guides: "Guides",
  allGuides: "All guides",
  guidesHref: "/en/guides",
  guideLabels: { schedule: "Making a rota", "working-time-act": "Working Hours Act", "on-call": "On-call workers", "labour-cost": "Labour cost" },
};

// A few popular guides, linked from every page.
const footerGuides = Object.entries(t.guideLabels)
  .map(([id, label]) => ({ label, guide: guides.find((g) => g.id === id && g.lang === lang) }))
  .filter((l) => l.guide !== undefined);
---
<footer class="bg-[var(--color-dark)] text-gray-400">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-16">
    <div class="flex flex-wrap justify-center gap-x-16 gap-y-10">

      <!-- Brand -->
      <div>
        <a href="/" class="flex items-center gap-2 mb-4" aria-label="Home">
          <img src="/favicon.png" alt="Gedekt logo" width="28" height="28" />
          <span class="text-white font-display font-semibold text-lg">Gedekt</span>
        </a>
        <p class="text-sm leading-relaxed mb-4">{t.tagline}</p>
        <p class="text-sm flex items-center gap-1.5">
          <span>&#127475;&#127473;</span>
          <span>{t.madeIn}</span>
        </p>
      </div>

      <!-- Nav links -->
      <div class="flex flex-wrap justify-center gap-x-10 gap-y-6 text-sm">
        <div>
          <h3 class="text-white font-semibold mb-3 uppercase tracking-wider">{t.product}</h3>
          <ul class="space-y-2">
            <li><a href={t.featuresHref} class="hover:text-white transition-colors">{t.features}</a></li>
            <li><a href={t.pricingHref} class="hover:text-white transition-colors">{t.pricing}</a></li>
            <li><a href={t.howItWorksHref} class="hover:text-white transition-colors">{t.howItWorks}</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-white font-semibold mb-3 uppercase tracking-wider">{t.company}</h3>
          <ul class="space-y-2">
            <li><a href={t.aboutHref} class="hover:text-white transition-colors">{t.about}</a></li>
            <li><a href={t.contactHref} class="hover:text-white transition-colors">{t.contact}</a></li>
            <li><a href={t.contactHref} class="hover:text-white transition-colors">{t.support}</a></li>
            <li><a href={t.manualHref} class="hover:text-white transition-colors">{t.manual}</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-white font-semibold mb-3 uppercase tracking-wider">{t.guides}</h3>
          <ul class="space-y-2">
            {footerGuides.map(({ label, guide }) => (
              <li><a href={guideHref(guide!)} class="hover:text-white transition-colors">{label}</a></li>
            ))}
            <li><a href={t.guidesHref} class="hover:text-white transition-colors">{t.allGuides} →</a></li>
          </ul>
        </div>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-8 border-t border-gray-800 text-center text-sm">
      <p>{t.copyright}</p>
    </div>
  </div>
</footer>
