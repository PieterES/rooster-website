---
// ConsentBanner.astro — cookie consent for Google Ads (Consent Mode v2).
// Defaults are set to "denied" in BaseLayout; this banner stores the choice and updates gtag.
interface Props {
  lang?: "nl" | "en";
}
const { lang = "en" } = Astro.props;

const t = lang === "nl" ? {
  title: "Cookies",
  body: "We gebruiken cookies van Google Ads om te meten hoe bezoekers ons vinden en om onze advertenties te verbeteren. Deze cookies plaatsen we alleen als je daar toestemming voor geeft. Je kunt je keuze altijd wijzigen via ‘Cookie-instellingen’ onderaan de pagina.",
  more: "Lees onze privacyverklaring",
  moreHref: "/privacy",
  accept: "Accepteren",
  decline: "Weigeren",
} : {
  title: "Cookies",
  body: "We use Google Ads cookies to measure how visitors find us and to improve our ads. We only set these cookies if you agree. You can change your choice at any time via ‘Cookie settings’ at the bottom of the page.",
  more: "Read our privacy statement",
  moreHref: "/en/privacy",
  accept: "Accept",
  decline: "Decline",
};
---
<div
  id="consent-banner"
  role="dialog"
  aria-labelledby="consent-title"
  aria-describedby="consent-body"
  class="hidden fixed inset-x-4 bottom-4 z-50 mx-auto max-w-xl rounded-2xl border border-gray-200 bg-white p-5 shadow-xl sm:p-6"
>
  <h2 id="consent-title" class="font-display text-lg font-semibold text-[var(--color-charcoal)] mb-2">{t.title}</h2>
  <p id="consent-body" class="text-sm leading-relaxed text-[var(--color-stone)] mb-4">
    {t.body} <a href={t.moreHref} class="text-[var(--color-forest)] underline underline-offset-2">{t.more}</a>
  </p>
  <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
    <button
      type="button"
      data-consent="denied"
      class="rounded-lg border border-[var(--color-forest)] px-5 py-2.5 text-sm font-semibold text-[var(--color-forest)] hover:bg-[var(--color-cream)] transition-colors"
    >{t.decline}</button>
    <button
      type="button"
      data-consent="granted"
      class="rounded-lg border border-[var(--color-forest)] bg-[var(--color-forest)] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[var(--color-forest-light)] transition-colors"
    >{t.accept}</button>
  </div>
</div>

<script>
  const KEY = "gedekt-consent";
  const banner = document.getElementById("consent-banner");

  function read() {
    try { return localStorage.getItem(KEY); } catch { return null; }
  }

  function choose(value: "granted" | "denied") {
    try { localStorage.setItem(KEY, value); } catch {}
    (window as any).gtag?.("consent", "update", {
      ad_storage: value,
      ad_user_data: value,
      ad_personalization: value,
      analytics_storage: value,
    });
    banner?.classList.add("hidden");
  }

  if (!read()) banner?.classList.remove("hidden");

  banner?.querySelectorAll<HTMLButtonElement>("[data-consent]").forEach((btn) => {
    btn.addEventListener("click", () => choose(btn.dataset.consent as "granted" | "denied"));
  });

  document.querySelectorAll("[data-consent-open]").forEach((el) => {
    el.addEventListener("click", () => banner?.classList.remove("hidden"));
  });
</script>
